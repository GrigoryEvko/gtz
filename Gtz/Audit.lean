-- ============================================================
-- the drift-proof axiom sweep: every theorem constant from every Gtz
-- module, enumerated from the ENVIRONMENT (not from this file's pin
-- list), the union of their proof closures walked once; the build
-- fails if any axiom outside the allowed three is reachable
-- ============================================================
open Lean in
run_cmd do
  let env ← getEnv
  let allowedAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let mut pendingConstants : Array Name := #[]
  let mut sweptTheoremCount : Nat := 0
  for (constName, constInfo) in env.constants.toList do
    if constInfo matches .thmInfo _ then
      if let some moduleIdx := env.getModuleIdxFor? constName then
        if (env.header.moduleNames[moduleIdx.toNat]!).getRoot == `Gtz then
          pendingConstants := pendingConstants.push constName
          sweptTheoremCount := sweptTheoremCount + 1
  let mut visitedConstants : NameSet := {}
  let mut reachableAxioms : NameSet := {}
  while pendingConstants.size > 0 do
    let currentName := pendingConstants.back!
    pendingConstants := pendingConstants.pop
    unless visitedConstants.contains currentName do
      visitedConstants := visitedConstants.insert currentName
      match env.find? currentName with
      | some (.axiomInfo _) => reachableAxioms := reachableAxioms.insert currentName
      | some constInfo =>
          for usedName in constInfo.getUsedConstantsAsSet do
            unless visitedConstants.contains usedName do
              pendingConstants := pendingConstants.push usedName
      | none => pure ()
  let rogueAxioms := reachableAxioms.toList.filter (fun axName => !allowedAxioms.contains axName)
  if rogueAxioms.isEmpty then
    logInfo m!"audit axiom sweep: {sweptTheoremCount} theorems across every Gtz module; reachable axioms {reachableAxioms.toList} are within the allowed set {allowedAxioms}"
  else
    throwError m!"audit axiom sweep FAILED: rogue axioms {rogueAxioms} are reachable from Gtz theorems"
