/-
# Certificate engine for the linear-space enumeration completeness statements

An UNTRUSTED generator (generate_certificate.py in this directory) runs a
depth-first search over the dependent-triple variables in lexicographic order,
variable `0` most significant, and records one leaf per maximal explored node.
The leaves partition the assignment interval `[0, 2^numVars)` into aligned
dyadic blocks, in increasing order:

  * a BAD-PREFIX leaf names either a falsified Horn closure instance whose
    three triples are assigned inside the prefix (two premises set, the
    conclusion clear), or the all-ones assignment (refuted by spanning);
  * a SOLUTION leaf is a full assignment carrying a catalogue class index and
    a relabelling onto that class.

The VERIFIED side is this engine: `isChunkRunAccepted` checks the leaf stream
against a cursor sweeping `[0, 2^numVars)`, and `isChunkRunAccepted_covers`
says that any code below `2^numVars` whose bad prefixes are all refutable lands
on an accepted solution leaf.  The engine knows nothing about patterns; the
size-specific semantics enter only through the `isBadPrefix` refutation
hypothesis and the `isSolutionOk` payload, discharged in the instantiating
file.

Leaf record, 72 bits, low bits first:
  bit 0      kind (0 bad prefix, 1 solution)
  bits 1-6   prefixLen
  bits 7-41  prefixVal (the prefix read most-significant-variable-first)
  bits 42-71 payload
-/
import Mathlib
import Gtz.Design.LinePatternEnumeration
import Gtz.Design.LinePatternCompleteness

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxRecDepth 100000
set_option exponentiation.threshold 4000

namespace Gtz
namespace MultiLineCert

/-! ## Small generic tools -/

/-- Decide `test` at every index below `bound`. -/
def holdsBelow (test : Nat → Bool) : Nat → Bool
  | 0 => true
  | bound + 1 => test bound && holdsBelow test bound

theorem holdsBelow_sound {test : Nat → Bool} :
    ∀ {bound : Nat}, holdsBelow test bound = true →
      ∀ {index : Nat}, index < bound → test index = true := by
  intro bound
  induction bound with
  | zero => intro _ index hlt; omega
  | succ prevBound ih =>
      intro hrun index hlt
      rw [holdsBelow, Bool.and_eq_true] at hrun
      rcases (by omega : index < prevBound ∨ index = prevBound) with hcase | hcase
      · exact ih hrun.2 hcase
      · subst hcase; exact hrun.1

/-- MSB-first packing of `bitCount` bits: variable `0` is the most significant,
variable `bitCount - 1` the least. -/
def encodeBits (bitAt : Nat → Bool) : Nat → Nat
  | 0 => 0
  | bitCount + 1 => 2 * encodeBits bitAt bitCount + (if bitAt bitCount then 1 else 0)

theorem encodeBits_lt (bitAt : Nat → Bool) :
    ∀ bitCount : Nat, encodeBits bitAt bitCount < 2 ^ bitCount := by
  intro bitCount
  induction bitCount with
  | zero => rw [encodeBits]; decide
  | succ prevCount ih =>
      rw [encodeBits, pow_succ]
      have hbit : (if bitAt prevCount then 1 else 0) ≤ 1 := by split <;> omega
      omega

theorem encodeBits_bit (bitAt : Nat → Bool) :
    ∀ bitCount varIdx : Nat, varIdx < bitCount →
      encodeBits bitAt bitCount / 2 ^ (bitCount - 1 - varIdx) % 2
        = (if bitAt varIdx then 1 else 0) := by
  intro bitCount
  induction bitCount with
  | zero => intro varIdx hlt; omega
  | succ prevCount ih =>
      intro varIdx hlt
      rcases (by omega : varIdx < prevCount ∨ varIdx = prevCount) with hcase | hcase
      · have hexp : prevCount + 1 - 1 - varIdx = (prevCount - 1 - varIdx) + 1 := by omega
        rw [encodeBits, hexp, pow_succ', ← Nat.div_div_eq_div_mul]
        have hhalf : (2 * encodeBits bitAt prevCount + (if bitAt prevCount then 1 else 0)) / 2
            = encodeBits bitAt prevCount := by split <;> omega
        rw [hhalf]
        exact ih varIdx hcase
      · subst hcase
        have hexp : varIdx + 1 - 1 - varIdx = 0 := by omega
        rw [encodeBits, hexp, pow_zero, Nat.div_one]
        split <;> omega

/-- Bits assigned inside a prefix survive into every code extending it: if
`codeValue / 2 ^ (numVars - prefixLen) = prefixVal` then the bit of `codeValue`
at variable `varIdx < prefixLen` is the corresponding bit of `prefixVal`. -/
theorem bitOfPrefix {numVars prefixLen prefixVal codeValue varIdx : Nat}
    (hvar : varIdx < prefixLen)
    (hdiv : codeValue / 2 ^ (numVars - prefixLen) = prefixVal)
    (hlen : prefixLen ≤ numVars) :
    codeValue / 2 ^ (numVars - 1 - varIdx) % 2
      = prefixVal / 2 ^ (prefixLen - 1 - varIdx) % 2 := by
  have hsplit : numVars - 1 - varIdx = (numVars - prefixLen) + (prefixLen - 1 - varIdx) := by
    omega
  rw [hsplit, pow_add, ← Nat.div_div_eq_div_mul, hdiv]

/-! ## The leaf engine -/

/-- One 72-bit leaf record checked against the sweeping cursor. -/
def isLeafAccepted (numVars : Nat) (isBadPrefix : Nat → Nat → Nat → Bool)
    (isSolutionOk : Nat → Nat → Bool) (cursor recordValue : Nat) : Bool :=
  decide (recordValue / 2 % 64 ≤ numVars) &&
  decide (cursor = recordValue / 128 % 2 ^ 35 * 2 ^ (numVars - recordValue / 2 % 64)) &&
  (bif recordValue % 2 == 0 then
    isBadPrefix (recordValue / 2 % 64) (recordValue / 128 % 2 ^ 35) (recordValue / 2 ^ 42)
  else
    decide (recordValue / 2 % 64 = numVars) &&
    isSolutionOk (recordValue / 128 % 2 ^ 35) (recordValue / 2 ^ 42))

/-- The dyadic width of a leaf's interval. -/
def leafSpan (numVars recordValue : Nat) : Nat := 2 ^ (numVars - recordValue / 2 % 64)

/-- Consume `fuel` leaf records from `packedLeaves`, advancing the cursor. -/
def consumeLeaves (numVars : Nat) (isBadPrefix : Nat → Nat → Nat → Bool)
    (isSolutionOk : Nat → Nat → Bool) : Nat → Nat → Nat → Option Nat
  | 0, cursor, _ => some cursor
  | fuel + 1, cursor, packedLeaves =>
      if isLeafAccepted numVars isBadPrefix isSolutionOk cursor (packedLeaves % 2 ^ 72) then
        consumeLeaves numVars isBadPrefix isSolutionOk fuel
          (cursor + leafSpan numVars (packedLeaves % 2 ^ 72)) (packedLeaves / 2 ^ 72)
      else
        none

/-- Run every chunk of `(leafCountInChunk, packedLeaves)` pairs; the cursor must
sweep `[0, 2 ^ numVars)` exactly. -/
def isChunkRunAccepted (numVars : Nat) (isBadPrefix : Nat → Nat → Nat → Bool)
    (isSolutionOk : Nat → Nat → Bool) : Nat → List (Nat × Nat) → Bool
  | cursor, [] => decide (cursor = 2 ^ numVars)
  | cursor, chunk :: rest =>
      match consumeLeaves numVars isBadPrefix isSolutionOk chunk.1 cursor chunk.2 with
      | none => false
      | some cursorNext => isChunkRunAccepted numVars isBadPrefix isSolutionOk cursorNext rest

/-! ## Engine soundness -/

theorem isLeafAccepted_covers {numVars : Nat} {isBadPrefix : Nat → Nat → Nat → Bool}
    {isSolutionOk : Nat → Nat → Bool} {cursor recordValue codeValue : Nat}
    (hleaf : isLeafAccepted numVars isBadPrefix isSolutionOk cursor recordValue = true)
    (hlow : cursor ≤ codeValue)
    (hhigh : codeValue < cursor + leafSpan numVars recordValue)
    (hbad : ∀ prefixLen prefixVal payload, isBadPrefix prefixLen prefixVal payload = true →
      prefixLen ≤ numVars → codeValue / 2 ^ (numVars - prefixLen) = prefixVal → False) :
    ∃ payload, isSolutionOk codeValue payload = true := by
  simp only [isLeafAccepted, Bool.and_eq_true] at hleaf
  obtain ⟨⟨hlenBool, hcursorBool⟩, hbranch⟩ := hleaf
  have hlen : recordValue / 2 % 64 ≤ numVars := of_decide_eq_true hlenBool
  have hcursor : cursor = recordValue / 128 % 2 ^ 35 * 2 ^ (numVars - recordValue / 2 % 64) :=
    of_decide_eq_true hcursorBool
  have hpow : 0 < 2 ^ (numVars - recordValue / 2 % 64) := Nat.two_pow_pos _
  have hlow' : recordValue / 128 % 2 ^ 35 * 2 ^ (numVars - recordValue / 2 % 64) ≤ codeValue := by
    rw [← hcursor]; exact hlow
  have hhigh' : codeValue
      < (recordValue / 128 % 2 ^ 35 + 1) * 2 ^ (numVars - recordValue / 2 % 64) := by
    rw [Nat.add_mul, one_mul, ← hcursor]
    simpa [leafSpan] using hhigh
  have hdiv : codeValue / 2 ^ (numVars - recordValue / 2 % 64) = recordValue / 128 % 2 ^ 35 :=
    le_antisymm
      (Nat.le_of_lt_succ ((Nat.div_lt_iff_lt_mul hpow).mpr hhigh'))
      ((Nat.le_div_iff_mul_le hpow).mpr hlow')
  cases hkind : (recordValue % 2 == 0) with
  | true =>
      rw [hkind, Bool.cond_true] at hbranch
      exact (hbad _ _ _ hbranch hlen hdiv).elim
  | false =>
      rw [hkind, Bool.cond_false, Bool.and_eq_true] at hbranch
      obtain ⟨hfullBool, hsol⟩ := hbranch
      have hfullLen : recordValue / 2 % 64 = numVars := of_decide_eq_true hfullBool
      rw [hfullLen, Nat.sub_self, pow_zero, Nat.div_one] at hdiv
      exact ⟨recordValue / 2 ^ 42, by rw [hdiv]; exact hsol⟩

theorem consumeLeaves_covers {numVars : Nat} {isBadPrefix : Nat → Nat → Nat → Bool}
    {isSolutionOk : Nat → Nat → Bool} {codeValue : Nat}
    (hbad : ∀ prefixLen prefixVal payload, isBadPrefix prefixLen prefixVal payload = true →
      prefixLen ≤ numVars → codeValue / 2 ^ (numVars - prefixLen) = prefixVal → False) :
    ∀ (fuel cursor packedLeaves cursorEnd : Nat),
      consumeLeaves numVars isBadPrefix isSolutionOk fuel cursor packedLeaves = some cursorEnd →
      cursor ≤ codeValue → codeValue < cursorEnd →
      ∃ payload, isSolutionOk codeValue payload = true := by
  intro fuel
  induction fuel with
  | zero =>
      intro cursor packedLeaves cursorEnd hconsume hle hlt
      rw [consumeLeaves] at hconsume
      injection hconsume with hcursorEq
      omega
  | succ prevFuel ih =>
      intro cursor packedLeaves cursorEnd hconsume hle hlt
      rw [consumeLeaves] at hconsume
      split at hconsume
      · rename_i hleaf
        rcases Nat.lt_or_ge codeValue (cursor + leafSpan numVars (packedLeaves % 2 ^ 72))
          with hin | hout
        · exact isLeafAccepted_covers hleaf hle hin hbad
        · exact ih _ _ _ hconsume hout hlt
      · exact absurd hconsume (by simp)

theorem isChunkRunAccepted_covers {numVars : Nat} {isBadPrefix : Nat → Nat → Nat → Bool}
    {isSolutionOk : Nat → Nat → Bool} {codeValue : Nat}
    (hcode : codeValue < 2 ^ numVars)
    (hbad : ∀ prefixLen prefixVal payload, isBadPrefix prefixLen prefixVal payload = true →
      prefixLen ≤ numVars → codeValue / 2 ^ (numVars - prefixLen) = prefixVal → False) :
    ∀ (chunks : List (Nat × Nat)) (cursor : Nat),
      isChunkRunAccepted numVars isBadPrefix isSolutionOk cursor chunks = true →
      cursor ≤ codeValue → ∃ payload, isSolutionOk codeValue payload = true := by
  intro chunks
  induction chunks with
  | nil =>
      intro cursor hrun hle
      rw [isChunkRunAccepted] at hrun
      have hend := of_decide_eq_true hrun
      omega
  | cons chunk rest ih =>
      intro cursor hrun hle
      rw [isChunkRunAccepted] at hrun
      split at hrun
      · exact absurd hrun (by simp)
      · rename_i cursorNext hconsume
        rcases Nat.lt_or_ge codeValue cursorNext with hin | hout
        · exact consumeLeaves_covers hbad chunk.1 cursor chunk.2 cursorNext hconsume hle hin
        · exact ih cursorNext hrun hout

/-! ## Generic pattern-level lemmas

The two swap axioms generate the full slot symmetry, so a pattern value
transports along any identification of one distinct triple with another
carrying the same labels; and the line law applied through the swaps turns two
dependent triples on a shared pair into both offshoot triples of their
four-label set. -/

/-- Transport a pattern value along a bijection of slots.  Only the SOURCE
distinctness is needed: if two source labels coincided with the same target
label they would coincide with each other. -/
theorem pattern_transport {size : ℕ} {pattern : LinePattern size}
    (haxioms : IsSpanningLinearSpacePattern pattern)
    {srcLeft srcMid srcRight dstLeft dstMid dstRight : Fin size}
    (hneLM : srcLeft ≠ srcMid) (hneLR : srcLeft ≠ srcRight) (hneMR : srcMid ≠ srcRight)
    (hmemLeft : srcLeft = dstLeft ∨ srcLeft = dstMid ∨ srcLeft = dstRight)
    (hmemMid : srcMid = dstLeft ∨ srcMid = dstMid ∨ srcMid = dstRight)
    (hmemRight : srcRight = dstLeft ∨ srcRight = dstMid ∨ srcRight = dstRight) :
    pattern srcLeft srcMid srcRight ↔ pattern dstLeft dstMid dstRight := by
  have swapLeft : ∀ labelOne labelTwo labelThree : Fin size,
      pattern labelOne labelTwo labelThree ↔ pattern labelTwo labelOne labelThree :=
    fun labelOne labelTwo labelThree =>
      ⟨haxioms.isLeftSwapClosed labelOne labelTwo labelThree,
       haxioms.isLeftSwapClosed labelTwo labelOne labelThree⟩
  have swapRight : ∀ labelOne labelTwo labelThree : Fin size,
      pattern labelOne labelTwo labelThree ↔ pattern labelOne labelThree labelTwo :=
    fun labelOne labelTwo labelThree =>
      ⟨haxioms.isRightSwapClosed labelOne labelTwo labelThree,
       haxioms.isRightSwapClosed labelOne labelThree labelTwo⟩
  rcases hmemLeft with rfl | rfl | rfl <;> rcases hmemMid with rfl | rfl | rfl <;>
    rcases hmemRight with rfl | rfl | rfl <;>
      first
        | exact absurd rfl hneLM
        | exact absurd rfl hneLR
        | exact absurd rfl hneMR
        | exact Iff.rfl
        | exact swapLeft _ _ _
        | exact swapRight _ _ _
        | exact (swapLeft _ _ _).trans (swapRight _ _ _)
        | exact (swapRight _ _ _).trans (swapLeft _ _ _)
        | exact ((swapLeft _ _ _).trans (swapRight _ _ _)).trans (swapLeft _ _ _)

/-- Two dependent triples on a shared distinct pair force both offshoot
triples of their four-label set. -/
theorem closure_offshoots {size : ℕ} {pattern : LinePattern size}
    (haxioms : IsSpanningLinearSpacePattern pattern)
    {labelA labelB labelC labelD : Fin size} (hneAB : labelA ≠ labelB)
    (hpremiseC : pattern labelA labelB labelC) (hpremiseD : pattern labelA labelB labelD) :
    pattern labelA labelC labelD ∧ pattern labelB labelC labelD :=
  ⟨haxioms.hasLineClosure labelA labelB labelC labelD hneAB hpremiseC hpremiseD,
   haxioms.hasLineClosure labelB labelA labelC labelD (Ne.symm hneAB)
     (haxioms.isLeftSwapClosed _ _ _ hpremiseC)
     (haxioms.isLeftSwapClosed _ _ _ hpremiseD)⟩
