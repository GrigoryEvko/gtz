/-- The class masks tabulate the listed line families: a distinct triple is
covered by a line of class `classIdx` exactly when its bit is set. -/
theorem classMaskSeven_finSound : ∀ classIdx : Fin 23, ∀ tripleIdx : Fin 35,
    ∀ labelLeft labelMid labelRight : Fin 7,
    (labelLeft ≠ labelMid ∧ labelLeft ≠ labelRight ∧ labelMid ≠ labelRight ∧
      MatchesTripleSeven tripleIdx.val labelLeft labelMid labelRight) →
    (lineFamilyPattern
        (lineFamiliesSeven[classIdx.val]'(by rw [length_lineFamiliesSeven]; exact classIdx.isLt))
        labelLeft labelMid labelRight ↔
      classMaskSeven classIdx.val / 2 ^ tripleIdx.val % 2 = 1) := by decide +kernel

/-! ## The classical triple set of an abstract pattern -/

/-- The labels of canonical triple `tripleIdx` as `Fin 7` values (junk indices
are wrapped by the modulus; real indices are unaffected, by
`labelsSeven_sound`). -/
def finLabelFirstSeven (tripleIdx : Nat) : Fin 7 :=
  ⟨labelFirstSeven tripleIdx % 7, Nat.mod_lt _ (by omega)⟩

def finLabelSecondSeven (tripleIdx : Nat) : Fin 7 :=
  ⟨labelSecondSeven tripleIdx % 7, Nat.mod_lt _ (by omega)⟩

def finLabelThirdSeven (tripleIdx : Nat) : Fin 7 :=
  ⟨labelThirdSeven tripleIdx % 7, Nat.mod_lt _ (by omega)⟩

/-- The pattern evaluated on canonical triple `tripleIdx`. -/
def patternAtIdxSeven (pattern : LinePattern 7) (tripleIdx : Nat) : Prop :=
  pattern (finLabelFirstSeven tripleIdx) (finLabelSecondSeven tripleIdx)
    (finLabelThirdSeven tripleIdx)

/-- Any distinct triple matching canonical triple `tripleIdx` carries the same
pattern value as the canonical evaluation, through the slot symmetry. -/
theorem patternAtIdxSeven_iff {pattern : LinePattern 7}
    (haxioms : IsSpanningLinearSpacePattern pattern)
    {tripleIdx : Nat} (hidx : tripleIdx < 35)
    {labelLeft labelMid labelRight : Fin 7}
    (hneLM : labelLeft ≠ labelMid) (hneLR : labelLeft ≠ labelRight)
    (hneMR : labelMid ≠ labelRight)
    (hmatch : MatchesTripleSeven tripleIdx labelLeft labelMid labelRight) :
    pattern labelLeft labelMid labelRight ↔ patternAtIdxSeven pattern tripleIdx := by
  obtain ⟨hfirstLt, hsecondLt, hthirdLt, -, -, -⟩ := labelsSeven_sound tripleIdx hidx
  have hvalFirst : (finLabelFirstSeven tripleIdx).val = labelFirstSeven tripleIdx :=
    Nat.mod_eq_of_lt hfirstLt
  have hvalSecond : (finLabelSecondSeven tripleIdx).val = labelSecondSeven tripleIdx :=
    Nat.mod_eq_of_lt hsecondLt
  have hvalThird : (finLabelThirdSeven tripleIdx).val = labelThirdSeven tripleIdx :=
    Nat.mod_eq_of_lt hthirdLt
  obtain ⟨hmatchLeft, hmatchMid, hmatchRight⟩ := hmatch
  show pattern labelLeft labelMid labelRight ↔
    pattern (finLabelFirstSeven tripleIdx) (finLabelSecondSeven tripleIdx)
      (finLabelThirdSeven tripleIdx)
  apply pattern_transport haxioms hneLM hneLR hneMR
  · rcases hmatchLeft with hcase | hcase | hcase
    · exact Or.inl (Fin.ext (hcase.trans hvalFirst.symm))
    · exact Or.inr (Or.inl (Fin.ext (hcase.trans hvalSecond.symm)))
    · exact Or.inr (Or.inr (Fin.ext (hcase.trans hvalThird.symm)))
  · rcases hmatchMid with hcase | hcase | hcase
    · exact Or.inl (Fin.ext (hcase.trans hvalFirst.symm))
    · exact Or.inr (Or.inl (Fin.ext (hcase.trans hvalSecond.symm)))
    · exact Or.inr (Or.inr (Fin.ext (hcase.trans hvalThird.symm)))
  · rcases hmatchRight with hcase | hcase | hcase
    · exact Or.inl (Fin.ext (hcase.trans hvalFirst.symm))
    · exact Or.inr (Or.inl (Fin.ext (hcase.trans hvalSecond.symm)))
    · exact Or.inr (Or.inr (Fin.ext (hcase.trans hvalThird.symm)))

/-! ## Refuting a conflict leaf against the pattern axioms -/

theorem conflictWitnessRefutedSeven {pattern : LinePattern 7} {bitAt : Nat → Bool}
    (haxioms : IsSpanningLinearSpacePattern pattern)
    (hbits : ∀ varIdx : Nat, varIdx < 35 →
      encodeBits bitAt 35 / 2 ^ (35 - 1 - varIdx) % 2 = (if bitAt varIdx then 1 else 0))
    (hbitAtIff : ∀ tripleIdx : Nat,
      (bitAt tripleIdx = true) ↔ patternAtIdxSeven pattern tripleIdx)
    {prefixLen prefixVal labelValA labelValB labelValC labelValD tag : Nat}
    (hlen : prefixLen ≤ 35)
    (hdiv : encodeBits bitAt 35 / 2 ^ (35 - prefixLen) = prefixVal)
    (hwitness : isConflictWitnessSeven prefixLen prefixVal labelValA labelValB labelValC
      labelValD tag = true) : False := by
  simp only [isConflictWitnessSeven, Bool.and_eq_true, decide_eq_true_eq, and_assoc] at hwitness
  obtain ⟨hAlt, hBlt, hClt, hDlt, hneAB, hneAC, hneAD, hneBC, hneBD, hneCD, hrefuted⟩ :=
    hwitness
  have patternOfSetBit : ∀ {labelU labelV labelW : Nat}
      (hUlt : labelU < 7) (hVlt : labelV < 7) (hWlt : labelW < 7),
      labelU ≠ labelV → labelU ≠ labelW → labelV ≠ labelW →
      tripleIdxOfSeven labelU labelV labelW < prefixLen →
      prefixVal / 2 ^ (prefixLen - 1 - tripleIdxOfSeven labelU labelV labelW) % 2 = 1 →
      pattern ⟨labelU, hUlt⟩ ⟨labelV, hVlt⟩ ⟨labelW, hWlt⟩ := by
    intro labelU labelV labelW hUlt hVlt hWlt hneUV hneUW hneVW hidxPrefix hbitSet
    obtain ⟨hidxLt, hmatchUVW⟩ :=
      tripleIdxOfSeven_sound labelU labelV labelW hUlt hVlt hWlt hneUV hneUW hneVW
    have hcodeBit : encodeBits bitAt 35 / 2 ^
        (35 - 1 - tripleIdxOfSeven labelU labelV labelW) % 2 = 1 := by
      rw [bitOfPrefix hidxPrefix hdiv hlen]; exact hbitSet
    have hbitTrue : bitAt (tripleIdxOfSeven labelU labelV labelW) = true := by
      have hval := hbits _ hidxLt
      rw [hcodeBit] at hval
      cases hb : bitAt (tripleIdxOfSeven labelU labelV labelW)
      · rw [hb] at hval; simp at hval
      · rfl
    exact (patternAtIdxSeven_iff haxioms hidxLt
        (fun heq => hneUV (congrArg Fin.val heq))
        (fun heq => hneUW (congrArg Fin.val heq))
        (fun heq => hneVW (congrArg Fin.val heq)) hmatchUVW).mpr
      ((hbitAtIff _).mp hbitTrue)
  have clearBitRefutes : ∀ {labelU labelV labelW : Nat}
      (hUlt : labelU < 7) (hVlt : labelV < 7) (hWlt : labelW < 7),
      labelU ≠ labelV → labelU ≠ labelW → labelV ≠ labelW →
      tripleIdxOfSeven labelU labelV labelW < prefixLen →
      prefixVal / 2 ^ (prefixLen - 1 - tripleIdxOfSeven labelU labelV labelW) % 2 = 0 →
      pattern ⟨labelU, hUlt⟩ ⟨labelV, hVlt⟩ ⟨labelW, hWlt⟩ → False := by
    intro labelU labelV labelW hUlt hVlt hWlt hneUV hneUW hneVW hidxPrefix hbitClear hpat
    obtain ⟨hidxLt, hmatchUVW⟩ :=
      tripleIdxOfSeven_sound labelU labelV labelW hUlt hVlt hWlt hneUV hneUW hneVW
    have hcodeBit : encodeBits bitAt 35 / 2 ^
        (35 - 1 - tripleIdxOfSeven labelU labelV labelW) % 2 = 0 := by
      rw [bitOfPrefix hidxPrefix hdiv hlen]; exact hbitClear
    have hbitTrue : bitAt (tripleIdxOfSeven labelU labelV labelW) = true :=
      (hbitAtIff _).mpr ((patternAtIdxSeven_iff haxioms hidxLt
        (fun heq => hneUV (congrArg Fin.val heq))
        (fun heq => hneUW (congrArg Fin.val heq))
        (fun heq => hneVW (congrArg Fin.val heq)) hmatchUVW).mp hpat)
    have hval := hbits _ hidxLt
    rw [hcodeBit, hbitTrue] at hval
    simp at hval
  simp only [isRefutedBitsSeven, Bool.and_eq_true, decide_eq_true_eq, and_assoc] at hrefuted
  obtain ⟨hpremOnePrefix, hpremTwoPrefix, hconclPrefix, hbitOne, hbitTwo, hbitConcl⟩ := hrefuted
  have hpatABC : pattern ⟨labelValA, hAlt⟩ ⟨labelValB, hBlt⟩ ⟨labelValC, hClt⟩ :=
    patternOfSetBit hAlt hBlt hClt hneAB hneAC hneBC hpremOnePrefix hbitOne
  have hpatABD : pattern ⟨labelValA, hAlt⟩ ⟨labelValB, hBlt⟩ ⟨labelValD, hDlt⟩ :=
    patternOfSetBit hAlt hBlt hDlt hneAB hneAD hneBD hpremTwoPrefix hbitTwo
  obtain ⟨hpatACD, hpatBCD⟩ := closure_offshoots haxioms
    (fun heq => hneAB (congrArg Fin.val heq)) hpatABC hpatABD
  cases htag : (tag == 0) with
  | true =>
      rw [htag, Bool.cond_true] at hconclPrefix hbitConcl
      exact clearBitRefutes hAlt hClt hDlt hneAC hneAD hneCD hconclPrefix hbitConcl hpatACD
  | false =>
      rw [htag, Bool.cond_false] at hconclPrefix hbitConcl
      exact clearBitRefutes hBlt hClt hDlt hneBC hneBD hneCD hconclPrefix hbitConcl hpatBCD

/-! ## The certificate run -/

set_option maxHeartbeats 12000000 in
theorem certificateRunSeven :
    isChunkRunAccepted 35 isBadPrefixSeven isSolutionOkSeven 0 leafChunksSeven = true := by
  decide +kernel

/-! ## The completeness theorem -/

/-- **Every spanning linear space on seven labels is a relabelled catalogue
entry**, certified by the leaf certificate rather than by structural case
analysis.  This statement has no unconditional producer in the shipped
tree; the conditional peel
`Gtz.linearSpaceListIsComplete_seven_of_multiLineCases` reduces it to
`Gtz.LinearSpaceMultiLineCasesSeven`, which is discharged below as a
corollary. -/
theorem linearSpaceListIsComplete_seven_certified :
    LinearSpaceListIsComplete 7 linePatternListSeven := by
  classical
  intro pattern haxioms
  set bitAt : Nat → Bool :=
    fun tripleIdx => decide (patternAtIdxSeven pattern tripleIdx) with hbitAtDef
  have hbitAtIff : ∀ tripleIdx : Nat,
      (bitAt tripleIdx = true) ↔ patternAtIdxSeven pattern tripleIdx := by
    intro tripleIdx
    rw [hbitAtDef]
    simp only [decide_eq_true_eq]
  have hcodeLt : encodeBits bitAt 35 < 2 ^ 35 := encodeBits_lt bitAt 35
  have hbits : ∀ varIdx : Nat, varIdx < 35 →
      encodeBits bitAt 35 / 2 ^ (35 - 1 - varIdx) % 2 = (if bitAt varIdx then 1 else 0) :=
    fun varIdx hlt => encodeBits_bit bitAt 35 varIdx hlt
  obtain ⟨spanLeft, spanMid, spanRight, hspanLM, hspanLR, hspanMR, hspanNot⟩ :=
    haxioms.isSpanning
  obtain ⟨hspanIdxLt, hspanMatch⟩ :=
    tripleIdxOfSeven_finSound spanLeft spanMid spanRight hspanLM hspanLR hspanMR
  have hspanBit : bitAt (tripleIdxOfSeven spanLeft.val spanMid.val spanRight.val) = false := by
    cases hb : bitAt (tripleIdxOfSeven spanLeft.val spanMid.val spanRight.val) with
    | false => rfl
    | true =>
        exact absurd ((patternAtIdxSeven_iff haxioms hspanIdxLt hspanLM hspanLR hspanMR
          hspanMatch).mpr ((hbitAtIff _).mp hb)) hspanNot
  have hbad : ∀ prefixLen prefixVal payload,
      isBadPrefixSeven prefixLen prefixVal payload = true →
      prefixLen ≤ 35 → encodeBits bitAt 35 / 2 ^ (35 - prefixLen) = prefixVal → False := by
    intro prefixLen prefixVal payload hcheck hlen hdiv
    simp only [isBadPrefixSeven] at hcheck
    cases hfull : (payload % 2 == 1) with
    | true =>
        rw [hfull, Bool.cond_true] at hcheck
        rw [Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq] at hcheck
        obtain ⟨hlenEq, hvalEq⟩ := hcheck
        rw [hlenEq, Nat.sub_self, pow_zero, Nat.div_one] at hdiv
        have hcodeEq : encodeBits bitAt 35 = 2 ^ 35 - 1 := hdiv.trans hvalEq
        have hzero := hbits _ hspanIdxLt
        rw [hcodeEq, allOnesBitSeven_sound _ hspanIdxLt, hspanBit] at hzero
        simp at hzero
    | false =>
        rw [hfull, Bool.cond_false] at hcheck
        exact conflictWitnessRefutedSeven haxioms hbits hbitAtIff hlen hdiv hcheck
  obtain ⟨payload, hsol⟩ := isChunkRunAccepted_covers hcodeLt hbad leafChunksSeven 0
    certificateRunSeven (Nat.zero_le _)
  simp only [isSolutionOkSeven, Bool.and_eq_true, decide_eq_true_eq, and_assoc] at hsol
  obtain ⟨hclassLt, hdigitsB, hdistinctB, hmaskB⟩ := hsol
  have hdigitLt : ∀ labelIdx : Nat, labelIdx < 7 →
      permDigitSeven (payload / 32) labelIdx < 7 :=
    fun labelIdx hlt => of_decide_eq_true (holdsBelow_sound hdigitsB hlt)
  have hdigitNe : ∀ {labelU labelV : Nat}, labelU < 7 → labelV < 7 → labelU ≠ labelV →
      permDigitSeven (payload / 32) labelU ≠ permDigitSeven (payload / 32) labelV := by
    intro labelU labelV hUlt hVlt hne
    rcases Nat.lt_or_ge labelU labelV with hlt | hge
    · exact fun heq =>
        of_decide_eq_true (holdsBelow_sound (holdsBelow_sound hdistinctB hVlt) hlt) heq.symm
    · have hlt' : labelV < labelU := by omega
      exact of_decide_eq_true (holdsBelow_sound (holdsBelow_sound hdistinctB hUlt) hlt')
  set permFin : Fin 7 → Fin 7 :=
    fun labelIdx => ⟨permDigitSeven (payload / 32) labelIdx.val,
      hdigitLt labelIdx.val labelIdx.isLt⟩ with hpermFinDef
  have hpermInj : Function.Injective permFin := by
    intro labelOne labelTwo heq
    by_contra hne
    have hvalNe : labelOne.val ≠ labelTwo.val := fun hv => hne (Fin.ext hv)
    exact hdigitNe labelOne.isLt labelTwo.isLt hvalNe (congrArg Fin.val heq)
  have hclassLtLen : payload % 32 < lineFamiliesSeven.length := by
    rw [length_lineFamiliesSeven]; exact hclassLt
  refine ⟨lineFamilyPattern (lineFamiliesSeven[payload % 32]'hclassLtLen), ?_,
    Equiv.ofBijective permFin (Finite.injective_iff_bijective.mp hpermInj),
    agreesOnDistinctTriples_of_forall ?_⟩
  · show lineFamilyPattern _ ∈ lineFamiliesSeven.map lineFamilyPattern
    exact List.mem_map.mpr ⟨_, List.getElem_mem hclassLtLen, rfl⟩
  · intro labelLeft labelMid labelRight hneLM hneLR hneMR
    obtain ⟨hidxLt, hmatch⟩ :=
      tripleIdxOfSeven_finSound labelLeft labelMid labelRight hneLM hneLR hneMR
    obtain ⟨hfirstLt, hsecondLt, hthirdLt, hneFS, hneFT, hneST⟩ :=
      labelsSeven_sound (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val) hidxLt
    obtain ⟨hpermIdxLt, hpermMatch⟩ :=
      tripleIdxOfSeven_sound
        (permDigitSeven (payload / 32)
          (labelFirstSeven (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val)))
        (permDigitSeven (payload / 32)
          (labelSecondSeven (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val)))
        (permDigitSeven (payload / 32)
          (labelThirdSeven (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val)))
        (hdigitLt _ hfirstLt) (hdigitLt _ hsecondLt) (hdigitLt _ hthirdLt)
        (hdigitNe hfirstLt hsecondLt hneFS) (hdigitNe hfirstLt hthirdLt hneFT)
        (hdigitNe hsecondLt hthirdLt hneST)
    obtain ⟨hpermArgFirst, hpermArgSecond, hpermArgThird⟩ := hpermMatch
    have transferOne : ∀ {sourceVal : Nat},
        (sourceVal = labelFirstSeven (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val) ∨
         sourceVal = labelSecondSeven (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val) ∨
         sourceVal = labelThirdSeven (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val)) →
        (permDigitSeven (payload / 32) sourceVal =
            labelFirstSeven (permutedTripleIdxSeven (payload / 32)
              (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val)) ∨
         permDigitSeven (payload / 32) sourceVal =
            labelSecondSeven (permutedTripleIdxSeven (payload / 32)
              (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val)) ∨
         permDigitSeven (payload / 32) sourceVal =
            labelThirdSeven (permutedTripleIdxSeven (payload / 32)
              (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val))) := by
      intro sourceVal hsource
      rcases hsource with hcase | hcase | hcase
      · rw [hcase]; exact hpermArgFirst
      · rw [hcase]; exact hpermArgSecond
      · rw [hcase]; exact hpermArgThird
    have hpermTripleMatch : MatchesTripleSeven
        (permutedTripleIdxSeven (payload / 32)
          (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val))
        (permFin labelLeft) (permFin labelMid) (permFin labelRight) :=
      ⟨transferOne hmatch.1, transferOne hmatch.2.1, transferOne hmatch.2.2⟩
    have hnePermLM : permFin labelLeft ≠ permFin labelMid :=
      fun heq => hneLM (hpermInj heq)
    have hnePermLR : permFin labelLeft ≠ permFin labelRight :=
      fun heq => hneLR (hpermInj heq)
    have hnePermMR : permFin labelMid ≠ permFin labelRight :=
      fun heq => hneMR (hpermInj heq)
    have hstepPattern : pattern labelLeft labelMid labelRight ↔
        (bitAt (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val) = true) :=
      (patternAtIdxSeven_iff haxioms hidxLt hneLM hneLR hneMR hmatch).trans
        (hbitAtIff _).symm
    have hstepBit : (bitAt (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val)
        = true) ↔
        encodeBits bitAt 35 / 2 ^
          (35 - 1 - tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val) % 2 = 1 := by
      rw [hbits _ hidxLt]
      cases bitAt (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val) <;> simp
    have hstepMask : encodeBits bitAt 35 / 2 ^
        (35 - 1 - tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val) % 2 =
        classMaskSeven (payload % 32) / 2 ^ (permutedTripleIdxSeven (payload / 32)
          (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val)) % 2 :=
      of_decide_eq_true (holdsBelow_sound hmaskB hidxLt)
    have hstepEq : (encodeBits bitAt 35 / 2 ^
        (35 - 1 - tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val) % 2 = 1) ↔
        (classMaskSeven (payload % 32) / 2 ^ (permutedTripleIdxSeven (payload / 32)
          (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val)) % 2 = 1) := by
      rw [hstepMask]
    have hstepBase : lineFamilyPattern (lineFamiliesSeven[payload % 32]'hclassLtLen)
        (permFin labelLeft) (permFin labelMid) (permFin labelRight) ↔
        classMaskSeven (payload % 32) / 2 ^ (permutedTripleIdxSeven (payload / 32)
          (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val)) % 2 = 1 :=
      classMaskSeven_finSound ⟨payload % 32, hclassLt⟩
        ⟨permutedTripleIdxSeven (payload / 32)
          (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val), hpermIdxLt⟩
        (permFin labelLeft) (permFin labelMid) (permFin labelRight)
        ⟨hnePermLM, hnePermLR, hnePermMR, hpermTripleMatch⟩
    exact hstepPattern.trans (hstepBit.trans (hstepEq.trans hstepBase.symm))

/-! ## The residual Prop, discharged

`Gtz.LinearSpaceMultiLineCasesSeven` (Gtz/Design/LinePatternCompleteness.lean)
is the eighteen-multi-line-class residual of the seven-point peel, stated with
a seed triple and a no-covering-line hypothesis.  The certified completeness
theorem is stronger: it needs neither hypothesis. -/

theorem linearSpaceMultiLineCasesSeven_holds : LinearSpaceMultiLineCasesSeven :=
  fun pattern haxioms _hseed _hnoCoveringLine =>
    linearSpaceListIsComplete_seven_certified pattern haxioms

end MultiLineCert
end Gtz
