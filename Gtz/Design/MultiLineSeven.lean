/-! ## Size-seven tables and checkers -/

/-- The three labels of canonical triple `tripleIdx`, packed nine bits per
triple in `tripleLabelsSeven`. -/
def labelFirstSeven (tripleIdx : Nat) : Nat := tripleLabelsSeven / 2 ^ (9 * tripleIdx) % 8

def labelSecondSeven (tripleIdx : Nat) : Nat := tripleLabelsSeven / 2 ^ (9 * tripleIdx + 3) % 8

def labelThirdSeven (tripleIdx : Nat) : Nat := tripleLabelsSeven / 2 ^ (9 * tripleIdx + 6) % 8

/-- The canonical triple index of three distinct labels, via the packed
six-bit-per-entry lookup table. -/
def tripleIdxOfSeven (labelLeft labelMid labelRight : Nat) : Nat :=
  tripleIndexTableSeven / 2 ^ (6 * (labelLeft * 49 + labelMid * 7 + labelRight)) % 64

/-- The dependent-triple bitmask of catalogue class `classIdx` (bit `t` set
iff canonical triple `t` lies inside a listed line). -/
def classMaskSeven (classIdx : Nat) : Nat := classMasksSeven / 2 ^ (35 * classIdx) % 2 ^ 35

/-- Digit `labelIdx` of a base-eight-packed permutation code. -/
def permDigitSeven (permCode labelIdx : Nat) : Nat := permCode / 2 ^ (3 * labelIdx) % 8

/-- The index of the image of canonical triple `tripleIdx` under the packed
permutation. -/
def permutedTripleIdxSeven (permCode tripleIdx : Nat) : Nat :=
  tripleIdxOfSeven (permDigitSeven permCode (labelFirstSeven tripleIdx))
    (permDigitSeven permCode (labelSecondSeven tripleIdx))
    (permDigitSeven permCode (labelThirdSeven tripleIdx))

/-- The three named triple indices are assigned inside the prefix, the two
premises set, the conclusion clear. -/
def isRefutedBitsSeven (prefixLen prefixVal premiseOne premiseTwo conclusion : Nat) : Bool :=
  decide (premiseOne < prefixLen) && decide (premiseTwo < prefixLen) &&
  decide (conclusion < prefixLen) &&
  decide (prefixVal / 2 ^ (prefixLen - 1 - premiseOne) % 2 = 1) &&
  decide (prefixVal / 2 ^ (prefixLen - 1 - premiseTwo) % 2 = 1) &&
  decide (prefixVal / 2 ^ (prefixLen - 1 - conclusion) % 2 = 0)

/-- Four distinct labels name a falsified Horn closure instance inside the
prefix: `{a,b,c}` and `{a,b,d}` set but `{a,c,d}` (tag `0`) or `{b,c,d}`
(tag `1`) clear. -/
def isConflictWitnessSeven (prefixLen prefixVal labelValA labelValB labelValC labelValD tag :
    Nat) : Bool :=
  decide (labelValA < 7) && decide (labelValB < 7) && decide (labelValC < 7) &&
  decide (labelValD < 7) &&
  decide (labelValA ≠ labelValB) && decide (labelValA ≠ labelValC) &&
  decide (labelValA ≠ labelValD) && decide (labelValB ≠ labelValC) &&
  decide (labelValB ≠ labelValD) && decide (labelValC ≠ labelValD) &&
  isRefutedBitsSeven prefixLen prefixVal
    (tripleIdxOfSeven labelValA labelValB labelValC)
    (tripleIdxOfSeven labelValA labelValB labelValD)
    (bif tag == 0 then tripleIdxOfSeven labelValA labelValC labelValD
     else tripleIdxOfSeven labelValB labelValC labelValD)

/-- A bad prefix: the all-ones assignment, or a falsified Horn instance. -/
def isBadPrefixSeven (prefixLen prefixVal payload : Nat) : Bool :=
  bif payload % 2 == 1 then
    decide (prefixLen = 35) && decide (prefixVal = 2 ^ 35 - 1)
  else
    isConflictWitnessSeven prefixLen prefixVal (payload / 2 % 8) (payload / 16 % 8)
      (payload / 128 % 8) (payload / 1024 % 8) (payload / 8192 % 2)

/-- A solution payload: a catalogue class below twenty-three and a permutation code
whose digits are a permutation of the seven labels carrying the solution's
triple set onto the class mask. -/
def isSolutionOkSeven (codeVal payload : Nat) : Bool :=
  decide (payload % 32 < 23) &&
  holdsBelow (fun labelIdx => decide (permDigitSeven (payload / 32) labelIdx < 7)) 7 &&
  holdsBelow (fun labelIdx => holdsBelow (fun otherIdx =>
    decide (permDigitSeven (payload / 32) labelIdx ≠ permDigitSeven (payload / 32) otherIdx))
    labelIdx) 7 &&
  holdsBelow (fun tripleIdx => decide (codeVal / 2 ^ (35 - 1 - tripleIdx) % 2 =
    classMaskSeven (payload % 32) / 2 ^ (permutedTripleIdxSeven (payload / 32) tripleIdx) % 2)) 35

/-- Three distinct labels all occur among the labels of canonical triple
`tripleIdx`. -/
def MatchesTripleSeven (tripleIdx : Nat) (labelLeft labelMid labelRight : Fin 7) : Prop :=
  (labelLeft.val = labelFirstSeven tripleIdx ∨ labelLeft.val = labelSecondSeven tripleIdx ∨
    labelLeft.val = labelThirdSeven tripleIdx) ∧
  (labelMid.val = labelFirstSeven tripleIdx ∨ labelMid.val = labelSecondSeven tripleIdx ∨
    labelMid.val = labelThirdSeven tripleIdx) ∧
  (labelRight.val = labelFirstSeven tripleIdx ∨ labelRight.val = labelSecondSeven tripleIdx ∨
    labelRight.val = labelThirdSeven tripleIdx)

instance decidableMatchesTripleSeven (tripleIdx : Nat)
    (labelLeft labelMid labelRight : Fin 7) :
    Decidable (MatchesTripleSeven tripleIdx labelLeft labelMid labelRight) := by
  unfold MatchesTripleSeven
  infer_instance

/-! ## Table facts, decided once -/

/-- Every canonical triple has three distinct labels below seven. -/
theorem labelsSeven_finSound : ∀ tripleIdx : Fin 35,
    labelFirstSeven tripleIdx.val < 7 ∧ labelSecondSeven tripleIdx.val < 7 ∧
    labelThirdSeven tripleIdx.val < 7 ∧
    labelFirstSeven tripleIdx.val ≠ labelSecondSeven tripleIdx.val ∧
    labelFirstSeven tripleIdx.val ≠ labelThirdSeven tripleIdx.val ∧
    labelSecondSeven tripleIdx.val ≠ labelThirdSeven tripleIdx.val := by decide

theorem labelsSeven_sound (tripleIdx : Nat) (hidx : tripleIdx < 35) :
    labelFirstSeven tripleIdx < 7 ∧ labelSecondSeven tripleIdx < 7 ∧
    labelThirdSeven tripleIdx < 7 ∧
    labelFirstSeven tripleIdx ≠ labelSecondSeven tripleIdx ∧
    labelFirstSeven tripleIdx ≠ labelThirdSeven tripleIdx ∧
    labelSecondSeven tripleIdx ≠ labelThirdSeven tripleIdx :=
  labelsSeven_finSound ⟨tripleIdx, hidx⟩

/-- The lookup table returns, on three distinct labels, an in-range triple
index matching them. -/
theorem tripleIdxOfSeven_finSound : ∀ labelLeft labelMid labelRight : Fin 7,
    labelLeft ≠ labelMid → labelLeft ≠ labelRight → labelMid ≠ labelRight →
    tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val < 35 ∧
    MatchesTripleSeven (tripleIdxOfSeven labelLeft.val labelMid.val labelRight.val)
      labelLeft labelMid labelRight := by decide

theorem tripleIdxOfSeven_sound (labelLeft labelMid labelRight : Nat)
    (hleftLt : labelLeft < 7) (hmidLt : labelMid < 7) (hrightLt : labelRight < 7)
    (hneLM : labelLeft ≠ labelMid) (hneLR : labelLeft ≠ labelRight)
    (hneMR : labelMid ≠ labelRight) :
    tripleIdxOfSeven labelLeft labelMid labelRight < 35 ∧
    MatchesTripleSeven (tripleIdxOfSeven labelLeft labelMid labelRight)
      ⟨labelLeft, hleftLt⟩ ⟨labelMid, hmidLt⟩ ⟨labelRight, hrightLt⟩ :=
  tripleIdxOfSeven_finSound ⟨labelLeft, hleftLt⟩ ⟨labelMid, hmidLt⟩ ⟨labelRight, hrightLt⟩
    (fun heq => hneLM (congrArg Fin.val heq)) (fun heq => hneLR (congrArg Fin.val heq))
    (fun heq => hneMR (congrArg Fin.val heq))

/-- Every bit of the all-ones code is set. -/
theorem allOnesBitSeven_finSound : ∀ varIdx : Fin 35,
    (2 ^ 35 - 1) / 2 ^ (35 - 1 - varIdx.val) % 2 = 1 := by decide

theorem allOnesBitSeven_sound (varIdx : Nat) (hvar : varIdx < 35) :
    (2 ^ 35 - 1) / 2 ^ (35 - 1 - varIdx) % 2 = 1 :=
  allOnesBitSeven_finSound ⟨varIdx, hvar⟩

