import Gtz.Wave.BothParallelEffectiveEntries

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# The both-parallel cross pin — the scalar certificate

The all-parallel C4 datum carries four basis directions, four
effective multipliers, and one cross gap entry between the two
single atoms.  This module proves that the entry vanishes.

The proof is a staged certificate in the folded scalar frame:

1. The two cross-block differences pin the four cross entries to one
   scalar, and the pair sign scalars fold every twin coordinate.
2. The branch relation and the first scale balance price the two
   cross-pair products against each other.
3. The contracted commutation entry of the four cross slots forces the
   two outer multiplier masses to agree.
4. The second diagonal read, reduced against the norms and the pinned
   masses, gives the compatibility relation of the coordinate squares.
5. Five folded entry equations and the weight sum make a six-row linear
   system in the cross scalar, the four weights, and the cross entry.
   The Cramer identity prices the entry, the numerator reduces to zero,
   and the determinant stays nonzero.

## PROVED here (no `sorry`, no `axiom`, no `native_decide`)

* `Gtz.crossPin_scalar_kill` — **THE SCALAR CROSS-PIN KILL.**

## Vacuity

Nothing here quantifies over a crux.  The statement holds for all real
numbers that obey the stated equations.
-/

namespace Gtz

set_option maxRecDepth 8000 in
set_option maxHeartbeats 6400000 in
/-- **THE SCALAR CROSS-PIN KILL.**  The folded entry
equations of the all-parallel C4 datum force the cross gap
entry to vanish.  The proof is the staged certificate: the
cross-block relations, the contracted commutation, the
compatibility chain, and the six-row Cramer identity. -/
theorem crossPin_scalar_kill
    (p1 r1 c1 d1 aD bB cB dD sa sc m n Gv : ℝ)
    (nuA nuB nuC nuD gbd gaa1 ga12 gcc1 gc12 : ℝ)
    (X11 X12 X21 X22 g1 g2 h1 h2 w0 wb w3 wd : ℝ)
    (hp1 : p1 ≠ 0) (hr1 : r1 ≠ 0) (hc1 : c1 ≠ 0) (hd1 : d1 ≠ 0)
    (haD : aD ≠ 0) (hbB : bB ≠ 0) (hcB : cB ≠ 0) (hdD : dD ≠ 0)
    (hmne : m ≠ 0) (hnne : n ≠ 0) (hnuBne : nuB ≠ 0)
    (hnuCne : nuC ≠ 0)
    (hSA : sa ^ 2 - 1 = 0) (hSC : sc ^ 2 - 1 = 0)
    (hD1 : nuA * p1 ^ 2 + nuB * r1 ^ 2 - 1/6 = 0)
    (hD2 : bB ^ 2 * nuB + cB ^ 2 * nuC - 1/6 = 0)
    (hD3 : c1 ^ 2 * nuC + d1 ^ 2 * nuD - 1/6 = 0)
    (hD4 : aD ^ 2 * nuA + dD ^ 2 * nuD - 1/6 = 0)
    (hN1 : aD ^ 2 + 2 * p1 ^ 2 - 1 = 0)
    (hN2 : bB ^ 2 + 2 * r1 ^ 2 - 1 = 0)
    (hN4 : 2 * d1 ^ 2 + dD ^ 2 - 1 = 0)
    (hS4 : aD ^ 2 * n * r1 ^ 2 - bB ^ 2 * m * p1 ^ 2 = 0)
    (hBR : aD * cB * d1 * r1 + bB * c1 * dD * p1 = 0)
    (hWS : 2 * w0 + 2 * w3 + wb + wd - 1 = 0)
    (hROW1 : bB * m + 2 * g1 * r1 = 0)
    (hROW2 : aD * n + 2 * g2 * p1 = 0)
    (hROW3 : 2 * c1 * h1 + cB * m = 0)
    (hROW4 : 2 * d1 * h2 + dD * n = 0)
    (hTA : -2 * Gv * r1 ^ 2 - bB ^ 2 * m + 2 * ga12 * r1 ^ 2 * sa + 2 * gaa1 * r1 ^ 2 = 0)
    (hTC : -2 * Gv * c1 ^ 2 + 2 * c1 ^ 2 * gc12 * sc + 2 * c1 ^ 2 * gcc1 - cB ^ 2 * m = 0)
    (hcomA1B : -Gv * bB * nuB * r1 + X11 * c1 * cB * nuC + X12 * c1 * cB * nuC * sc - aD * gbd * nuA * p1 + bB ^ 2 * g1 * nuB + bB * ga12 * nuB * r1 * sa + bB * gaa1 * nuB * r1 - bB * m * nuB * r1 + bB * nuB * r1 * w0 - bB * nuB * r1 * wb + cB ^ 2 * g1 * nuC - g1 * nuA * p1 ^ 2 * sa ^ 2 - g1 * nuA * p1 ^ 2 - g1 * nuB * r1 ^ 2 * sa ^ 2 - g1 * nuB * r1 ^ 2 = 0)
    (hcomA2B : -Gv * bB * nuB * r1 * sa + X21 * c1 * cB * nuC + X22 * c1 * cB * nuC * sc - aD * gbd * nuA * p1 * sa + bB ^ 2 * g1 * nuB * sa + bB * ga12 * nuB * r1 + bB * gaa1 * nuB * r1 * sa - bB * m * nuB * r1 * sa + bB * nuB * r1 * sa * w0 - bB * nuB * r1 * sa * wb + cB ^ 2 * g1 * nuC * sa - g1 * nuA * p1 ^ 2 * sa ^ 3 - g1 * nuA * p1 ^ 2 * sa - g1 * nuB * r1 ^ 2 * sa ^ 3 - g1 * nuB * r1 ^ 2 * sa = 0)
    (hcomBC1 : Gv * c1 * cB * nuC - X11 * bB * nuB * r1 - X21 * bB * nuB * r1 * sa - bB ^ 2 * h1 * nuB + c1 ^ 2 * h1 * nuC * sc ^ 2 + c1 ^ 2 * h1 * nuC - c1 * cB * gc12 * nuC * sc - c1 * cB * gcc1 * nuC + c1 * cB * m * nuC - c1 * cB * nuC * w3 + c1 * cB * nuC * wb - cB ^ 2 * h1 * nuC + d1 ^ 2 * h1 * nuD * sc ^ 2 + d1 ^ 2 * h1 * nuD + d1 * dD * gbd * nuD = 0)
    (hcomBC2 : Gv * c1 * cB * nuC * sc - X12 * bB * nuB * r1 - X22 * bB * nuB * r1 * sa - bB ^ 2 * h1 * nuB * sc + c1 ^ 2 * h1 * nuC * sc ^ 3 + c1 ^ 2 * h1 * nuC * sc - c1 * cB * gc12 * nuC - c1 * cB * gcc1 * nuC * sc + c1 * cB * m * nuC * sc - c1 * cB * nuC * sc * w3 + c1 * cB * nuC * sc * wb - cB ^ 2 * h1 * nuC * sc + d1 ^ 2 * h1 * nuD * sc ^ 3 + d1 ^ 2 * h1 * nuD * sc + d1 * dD * gbd * nuD * sc = 0)
    (hcomA1C1 : X11 * c1 ^ 2 * nuC + X11 * d1 ^ 2 * nuD - X11 * nuA * p1 ^ 2 - X11 * nuB * r1 ^ 2 + X12 * c1 ^ 2 * nuC * sc + X12 * d1 ^ 2 * nuD * sc - X21 * nuA * p1 ^ 2 * sa - X21 * nuB * r1 ^ 2 * sa - aD * h2 * nuA * p1 - bB * h1 * nuB * r1 + c1 * cB * g1 * nuC + d1 * dD * g2 * nuD = 0)
    (hcomA1C2 : X11 * c1 ^ 2 * nuC * sc + X11 * d1 ^ 2 * nuD * sc + X12 * c1 ^ 2 * nuC * sc ^ 2 + X12 * d1 ^ 2 * nuD * sc ^ 2 - X12 * nuA * p1 ^ 2 - X12 * nuB * r1 ^ 2 - X22 * nuA * p1 ^ 2 * sa - X22 * nuB * r1 ^ 2 * sa - aD * h2 * nuA * p1 * sc - bB * h1 * nuB * r1 * sc + c1 * cB * g1 * nuC * sc + d1 * dD * g2 * nuD * sc = 0)
    (hcomA2C1 : -X11 * nuA * p1 ^ 2 * sa - X11 * nuB * r1 ^ 2 * sa + X21 * c1 ^ 2 * nuC + X21 * d1 ^ 2 * nuD - X21 * nuA * p1 ^ 2 * sa ^ 2 - X21 * nuB * r1 ^ 2 * sa ^ 2 + X22 * c1 ^ 2 * nuC * sc + X22 * d1 ^ 2 * nuD * sc - aD * h2 * nuA * p1 * sa - bB * h1 * nuB * r1 * sa + c1 * cB * g1 * nuC * sa + d1 * dD * g2 * nuD * sa = 0)
    (hcomA2C2 : -X12 * nuA * p1 ^ 2 * sa - X12 * nuB * r1 ^ 2 * sa + X21 * c1 ^ 2 * nuC * sc + X21 * d1 ^ 2 * nuD * sc + X22 * c1 ^ 2 * nuC * sc ^ 2 + X22 * d1 ^ 2 * nuD * sc ^ 2 - X22 * nuA * p1 ^ 2 * sa ^ 2 - X22 * nuB * r1 ^ 2 * sa ^ 2 - aD * h2 * nuA * p1 * sa * sc - bB * h1 * nuB * r1 * sa * sc + c1 * cB * g1 * nuC * sa * sc + d1 * dD * g2 * nuD * sa * sc = 0)
    (hidmA1B : Gv * g1 + X11 * h1 + X12 * h1 * sc + g1 * ga12 * sa + g1 * gaa1 + g1 * m + g1 * w0 + g1 * wb - g1 + g2 * gbd = 0)
    (hidmA1D : Gv * g2 + X11 * h2 + X12 * h2 * sc + g1 * gbd + g2 * ga12 * sa + g2 * gaa1 + g2 * n + g2 * w0 + g2 * wd - g2 = 0)
    (hidmBC1 : Gv * h1 + X11 * g1 + X21 * g1 * sa + gbd * h2 + gc12 * h1 * sc + gcc1 * h1 + h1 * m + h1 * w3 + h1 * wb - h1 = 0)
    : gbd = 0 := by

  have hsane : sa ≠ 0 := by
    intro hz
    rw [hz] at hSA
    norm_num at hSA
  have hscne : sc ≠ 0 := by
    intro hz
    rw [hz] at hSC
    norm_num at hSC
  obtain ⟨XS, hXSD⟩ : ∃ XSv : ℝ, XSv - X11 - sc * X12 = 0 :=
    ⟨X11 + sc * X12, by ring⟩
  have hxd1 : c1 * cB * nuC * (-X11 * sa - X12 * sa * sc + X21 + X22 * sc) = 0 := by
    linear_combination hcomA2B - sa * hcomA1B + bB * ga12 * nuB * r1 * hSA
  have hXREL1 : (-X11 * sa - X12 * sa * sc + X21 + X22 * sc) = 0 :=
    (mul_eq_zero.mp hxd1).resolve_left
      (mul_ne_zero (mul_ne_zero hc1 hcB) hnuCne)
  have hxd2 : bB * nuB * r1 * (-X11 * sc + X12 - X21 * sa * sc + X22 * sa) = 0 := by
    linear_combination sc * hcomBC1 - hcomBC2 + c1 * cB * gc12 * nuC * hSC
  have hXREL2 : (-X11 * sc + X12 - X21 * sa * sc + X22 * sa) = 0 :=
    (mul_eq_zero.mp hxd2).resolve_left
      (mul_ne_zero (mul_ne_zero hbB hnuBne) hr1)
  have hXR3 : X21 - sa * (XS - X11) = 0 := by
    linear_combination (1 / 2 : ℝ) * hXREL1 - sa * sc / 2 * hXREL2
      - sa * hXSD + (-(X21 * sc ^ 2) / 2 + X22 * sc / 2) * hSA
      + (-(X11 * sa) / 2 - X21 / 2) * hSC
  have hXR4 : X22 - sa * sc * X11 = 0 := by
    linear_combination sc / 2 * hXREL1 + sa / 2 * hXREL2
      + (X21 * sc / 2 - X22 / 2) * hSA + (X12 * sa / 2 - X22 / 2) * hSC
  have hTsum : n * (aD * dD * r1 * c1) + m * (bB * cB * p1 * d1) = 0 := by
    have hstep : aD * r1 * d1
        * (n * (aD * dD * r1 * c1) + m * (bB * cB * p1 * d1)) = 0 := by
      linear_combination m * bB * p1 * d1 * hBR + dD * c1 * d1 * hS4
    exact (mul_eq_zero.mp hstep).resolve_left
      (mul_ne_zero (mul_ne_zero haD hr1) hd1)

  have hrowF1 : (-4 : ℝ) * r1 ^ 3 * sc * (2 * XS * c1 * cB * nuC * r1 - 2 * aD * gbd * nuA * p1 * r1 - bB * cB ^ 2 * m * nuC + 2 * bB * m * nuA * p1 ^ 2 + 2 * bB * nuB * r1 ^ 2 * w0 - 2 * bB * nuB * r1 ^ 2 * wb) = 0 := by
    linear_combination (-8 * r1 ^ 4 * sc) * hcomA1B
      - (8 * c1 * cB * nuC * r1 ^ 4 * sc) * hXSD
      - (-4 * bB * nuB * r1 ^ 3 * sc) * hTA
      - (-4 * bB ^ 2 * nuB * r1 ^ 3 * sc - 4 * cB ^ 2 * nuC * r1 ^ 3 * sc + 4 * nuA * p1 ^ 2 * r1 ^ 3 * sa ^ 2 * sc + 4 * nuA * p1 ^ 2 * r1 ^ 3 * sc + 4 * nuB * r1 ^ 5 * sa ^ 2 * sc + 4 * nuB * r1 ^ 5 * sc) * hROW1
      - (-4 * bB * m * nuA * p1 ^ 2 * r1 ^ 3 * sc - 4 * bB * m * nuB * r1 ^ 5 * sc) * hSA

  have hrowF3 : (4 : ℝ) * c1 ^ 3 * (-2 * XS * bB * c1 * nuB * r1 + bB ^ 2 * cB * m * nuB - 2 * c1 ^ 2 * cB * nuC * w3 + 2 * c1 ^ 2 * cB * nuC * wb + 2 * c1 * d1 * dD * gbd * nuD - 2 * cB * d1 ^ 2 * m * nuD) = 0 := by
    linear_combination (8 * c1 ^ 4) * hcomBC1
      - (-8 * bB * c1 ^ 4 * nuB * r1 * sa) * hXR3
      - (-4 * c1 ^ 3 * cB * nuC) * hTC
      - (-4 * bB ^ 2 * c1 ^ 3 * nuB + 4 * c1 ^ 5 * nuC * sc ^ 2 + 4 * c1 ^ 5 * nuC - 4 * c1 ^ 3 * cB ^ 2 * nuC + 4 * c1 ^ 3 * d1 ^ 2 * nuD * sc ^ 2 + 4 * c1 ^ 3 * d1 ^ 2 * nuD) * hROW3
      - (8 * X11 * bB * c1 ^ 4 * nuB * r1 - 8 * XS * bB * c1 ^ 4 * nuB * r1) * hSA
      - (-4 * c1 ^ 5 * cB * m * nuC - 4 * c1 ^ 3 * cB * d1 ^ 2 * m * nuD) * hSC

  have hrowI1 : (-16 : ℝ) * c1 * p1 * r1 ^ 3 * sc * (-4 * Gv * bB * c1 * m * p1 * r1 ^ 2 - 2 * XS * cB * m * p1 * r1 ^ 3 - 2 * aD * c1 * gbd * n * r1 ^ 3 - bB ^ 3 * c1 * m ^ 2 * p1 - 2 * bB * c1 * m ^ 2 * p1 * r1 ^ 2 - 2 * bB * c1 * m * p1 * r1 ^ 2 * w0 - 2 * bB * c1 * m * p1 * r1 ^ 2 * wb + 2 * bB * c1 * m * p1 * r1 ^ 2) = 0 := by
    linear_combination (-64 * c1 ^ 2 * p1 ^ 2 * r1 ^ 6 * sc) * hidmA1B
      - (64 * c1 ^ 2 * h1 * p1 ^ 2 * r1 ^ 6 * sc) * hXSD
      - (-32 * c1 ^ 2 * g1 * p1 ^ 2 * r1 ^ 4 * sc) * hTA
      - (-64 * Gv * c1 ^ 2 * p1 ^ 2 * r1 ^ 5 * sc - 16 * bB ^ 2 * c1 ^ 2 * m * p1 ^ 2 * r1 ^ 3 * sc - 32 * c1 ^ 2 * m * p1 ^ 2 * r1 ^ 5 * sc - 32 * c1 ^ 2 * p1 ^ 2 * r1 ^ 5 * sc * w0 - 32 * c1 ^ 2 * p1 ^ 2 * r1 ^ 5 * sc * wb + 32 * c1 ^ 2 * p1 ^ 2 * r1 ^ 5 * sc) * hROW1
      - (-32 * c1 ^ 2 * gbd * p1 * r1 ^ 6 * sc) * hROW2
      - (-32 * XS * c1 * p1 ^ 2 * r1 ^ 6 * sc) * hROW3

  have hrowI2 : (-16 : ℝ) * d1 * p1 * r1 ^ 3 * sc * (-4 * Gv * aD * d1 * n * r1 ^ 2 - 2 * XS * dD * n * p1 * r1 ^ 2 - aD * bB ^ 2 * d1 * m * n - 2 * aD * d1 * n ^ 2 * r1 ^ 2 - 2 * aD * d1 * n * r1 ^ 2 * w0 - 2 * aD * d1 * n * r1 ^ 2 * wd + 2 * aD * d1 * n * r1 ^ 2 - 2 * bB * d1 * gbd * m * p1 * r1) = 0 := by
    linear_combination (-64 * d1 ^ 2 * p1 ^ 2 * r1 ^ 5 * sc) * hidmA1D
      - (64 * d1 ^ 2 * h2 * p1 ^ 2 * r1 ^ 5 * sc) * hXSD
      - (-32 * d1 ^ 2 * g2 * p1 ^ 2 * r1 ^ 3 * sc) * hTA
      - (-32 * d1 ^ 2 * gbd * p1 ^ 2 * r1 ^ 4 * sc) * hROW1
      - (-64 * Gv * d1 ^ 2 * p1 * r1 ^ 5 * sc - 16 * bB ^ 2 * d1 ^ 2 * m * p1 * r1 ^ 3 * sc - 32 * d1 ^ 2 * n * p1 * r1 ^ 5 * sc - 32 * d1 ^ 2 * p1 * r1 ^ 5 * sc * w0 - 32 * d1 ^ 2 * p1 * r1 ^ 5 * sc * wd + 32 * d1 ^ 2 * p1 * r1 ^ 5 * sc) * hROW2
      - (-32 * XS * d1 * p1 ^ 2 * r1 ^ 5 * sc) * hROW4

  have hrowI3 : (16 : ℝ) * c1 ^ 3 * d1 * r1 * (-4 * Gv * c1 ^ 2 * cB * d1 * m * r1 - 2 * XS * bB * c1 ^ 3 * d1 * m - 2 * c1 ^ 3 * dD * gbd * n * r1 - 2 * c1 ^ 2 * cB * d1 * m ^ 2 * r1 - 2 * c1 ^ 2 * cB * d1 * m * r1 * w3 - 2 * c1 ^ 2 * cB * d1 * m * r1 * wb + 2 * c1 ^ 2 * cB * d1 * m * r1 - cB ^ 3 * d1 * m ^ 2 * r1) = 0 := by
    linear_combination (64 * c1 ^ 6 * d1 ^ 2 * r1 ^ 2) * hidmBC1
      - (64 * c1 ^ 6 * d1 ^ 2 * g1 * r1 ^ 2 * sa) * hXR3
      - (32 * c1 ^ 4 * d1 ^ 2 * h1 * r1 ^ 2) * hTC
      - (-32 * X11 * c1 ^ 6 * d1 ^ 2 * r1 * sa ^ 2 + 32 * X11 * c1 ^ 6 * d1 ^ 2 * r1 + 32 * XS * c1 ^ 6 * d1 ^ 2 * r1 * sa ^ 2) * hROW1
      - (64 * Gv * c1 ^ 5 * d1 ^ 2 * r1 ^ 2 + 32 * c1 ^ 5 * d1 ^ 2 * m * r1 ^ 2 + 32 * c1 ^ 5 * d1 ^ 2 * r1 ^ 2 * w3 + 32 * c1 ^ 5 * d1 ^ 2 * r1 ^ 2 * wb - 32 * c1 ^ 5 * d1 ^ 2 * r1 ^ 2 + 16 * c1 ^ 3 * cB ^ 2 * d1 ^ 2 * m * r1 ^ 2) * hROW3
      - (32 * c1 ^ 6 * d1 * gbd * r1 ^ 2) * hROW4
      - (32 * X11 * bB * c1 ^ 6 * d1 ^ 2 * m * r1 - 32 * XS * bB * c1 ^ 6 * d1 ^ 2 * m * r1) * hSA

  have hrowF1z := (mul_eq_zero.mp hrowF1).resolve_left (mul_ne_zero (mul_ne_zero (by norm_num : (-4 : ℝ) ≠ 0) (pow_ne_zero 3 hr1)) hscne)
  have hrowF3z := (mul_eq_zero.mp hrowF3).resolve_left (mul_ne_zero (by norm_num : (4 : ℝ) ≠ 0) (pow_ne_zero 3 hc1))
  have hrowI1z := (mul_eq_zero.mp hrowI1).resolve_left (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num : (-16 : ℝ) ≠ 0) hc1) hp1) (pow_ne_zero 3 hr1)) hscne)
  have hrowI2z := (mul_eq_zero.mp hrowI2).resolve_left (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num : (-16 : ℝ) ≠ 0) hd1) hp1) (pow_ne_zero 3 hr1)) hscne)
  have hrowI3z := (mul_eq_zero.mp hrowI3).resolve_left (mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num : (16 : ℝ) ≠ 0) (pow_ne_zero 3 hc1)) hd1) hr1)
  have hWSz : 2 * w0 + wb + 2 * w3 + wd - 1 = 0 := by linear_combination hWS

  have hCT : (32 * c1 * d1 * p1 * r1)
      * ((nuA * p1 ^ 2 - nuD * d1 ^ 2)
        * (n * (aD * dD * r1 * c1) - m * (bB * cB * p1 * d1))) = 0 := by
    linear_combination (16 * c1 ^ 2 * d1 ^ 2 * p1 ^ 2 * r1 ^ 2) * hcomA1C1
      + (16 * c1 ^ 2 * d1 ^ 2 * p1 ^ 2 * r1 ^ 2 * sc) * hcomA1C2
      + (16 * c1 ^ 2 * d1 ^ 2 * p1 ^ 2 * r1 ^ 2 * sa) * hcomA2C1
      + (16 * c1 ^ 2 * d1 ^ 2 * p1 ^ 2 * r1 ^ 2 * sa * sc) * hcomA2C2
      + (32 * X11 * c1 ^ 2 * d1 ^ 2 * p1 ^ 2 * r1 ^ 2 + 32 * X12 * c1 ^ 2 * d1 ^ 2 * p1 ^ 2 * r1 ^ 2 * sc + 32 * X21 * c1 ^ 2 * d1 ^ 2 * p1 ^ 2 * r1 ^ 2 * sa + 32 * X22 * c1 ^ 2 * d1 ^ 2 * p1 ^ 2 * r1 ^ 2 * sa * sc - 32 * bB * c1 * cB * d1 ^ 2 * m * p1 ^ 2 * r1) * hD1
      + (-32 * X11 * c1 ^ 2 * d1 ^ 2 * p1 ^ 2 * r1 ^ 2 - 32 * X12 * c1 ^ 2 * d1 ^ 2 * p1 ^ 2 * r1 ^ 2 * sc - 32 * X21 * c1 ^ 2 * d1 ^ 2 * p1 ^ 2 * r1 ^ 2 * sa - 32 * X22 * c1 ^ 2 * d1 ^ 2 * p1 ^ 2 * r1 ^ 2 * sa * sc + 32 * bB * c1 * cB * d1 ^ 2 * m * p1 ^ 2 * r1) * hD3
      + (-(8 * c1 ^ 3 * cB * d1 ^ 2 * nuC * p1 ^ 2 * r1 * sa ^ 2 * sc ^ 2 + 8 * c1 ^ 3 * cB * d1 ^ 2 * nuC * p1 ^ 2 * r1 * sa ^ 2 + 8 * c1 ^ 3 * cB * d1 ^ 2 * nuC * p1 ^ 2 * r1 * sc ^ 2 + 8 * c1 ^ 3 * cB * d1 ^ 2 * nuC * p1 ^ 2 * r1)) * hROW1
      + (-(8 * c1 ^ 2 * d1 ^ 3 * dD * nuD * p1 * r1 ^ 2 * sa ^ 2 * sc ^ 2 + 8 * c1 ^ 2 * d1 ^ 3 * dD * nuD * p1 * r1 ^ 2 * sa ^ 2 + 8 * c1 ^ 2 * d1 ^ 3 * dD * nuD * p1 * r1 ^ 2 * sc ^ 2 + 8 * c1 ^ 2 * d1 ^ 3 * dD * nuD * p1 * r1 ^ 2)) * hROW2
      + (-(-8 * bB * c1 * d1 ^ 2 * nuB * p1 ^ 2 * r1 ^ 3 * sa ^ 2 * sc ^ 2 - 8 * bB * c1 * d1 ^ 2 * nuB * p1 ^ 2 * r1 ^ 3 * sa ^ 2 - 8 * bB * c1 * d1 ^ 2 * nuB * p1 ^ 2 * r1 ^ 3 * sc ^ 2 - 8 * bB * c1 * d1 ^ 2 * nuB * p1 ^ 2 * r1 ^ 3)) * hROW3
