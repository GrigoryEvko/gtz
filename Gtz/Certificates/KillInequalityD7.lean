is a positive multiple of `y2 ^ 2`. -/
def weightFormFromSecond (y1 y2 y3 : ℝ) : ℝ :=
  9350 * (y1 - (549 / 550) * y2 - (10993 / 9350) * y3) ^ 2
  + (22769951 / 9350) * ((11846331 / 22769951) * y2 + y3) ^ 2
  + (35175117600 / 22769951) * (y2) ^ 2

