    rw [← hdominant]
    exact pairForm34_le_maxPairForm y1 y2 y3
  have h0 : 0 ≤ dominance0 y1 y2 y3 := by
    rw [dominance0_eq]
    linarith [hbound01]
  have h1 : 0 ≤ dominance1 y1 y2 y3 := by
    rw [dominance1_eq]
    linarith [hbound02]
  have h2 : 0 ≤ dominance2 y1 y2 y3 := by
