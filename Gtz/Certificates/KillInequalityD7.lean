    exact pairForm12_le_maxPairForm y1 y2 y3
  have hbound13 : pairForm13 y1 y2 y3 ≤ pairForm04 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm13_le_maxPairForm y1 y2 y3
  have hbound14 : pairForm14 y1 y2 y3 ≤ pairForm04 y1 y2 y3 := by
