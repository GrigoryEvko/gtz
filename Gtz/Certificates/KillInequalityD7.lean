/-- **The cell theorem.** -/
theorem targetForm_nonneg_on_cell (y1 y2 y3 : ℝ)
    (hne : y1 ≠ 0 ∨ y2 ≠ 0 ∨ y3 ≠ 0)
    (h0 : 0 ≤ dominance0 y1 y2 y3)
    (h1 : 0 ≤ dominance1 y1 y2 y3)
    (h2 : 0 ≤ dominance2 y1 y2 y3)
