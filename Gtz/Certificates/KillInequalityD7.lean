    linarith [hbound23]
  have h7 : 0 ≤ dominance7 y1 y2 y3 := by
    rw [dominance7_eq]
    linarith [hbound24]
  have h8 : 0 ≤ dominance8 y1 y2 y3 := by
    rw [dominance8_eq]
