is a positive multiple of `y1 ^ 2`. -/
def weightFormFromThird (y1 y2 y3 : ℝ) : ℝ :=
  8256 * ((135 / 172) * y1 + (279 / 172) * y2 + y3) ^ 2
  + (277992 / 43) * ((1147 / 2574) * y1 + y2) ^ 2
  + (269730 / 143) * (y1) ^ 2

