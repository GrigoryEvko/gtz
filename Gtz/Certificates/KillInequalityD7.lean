    exact pairForm14_le_maxPairForm y1 y2 y3
  have hbound23 : pairForm23 y1 y2 y3 ≤ pairForm12 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm23_le_maxPairForm y1 y2 y3
  have hbound24 : pairForm24 y1 y2 y3 ≤ pairForm12 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm24_le_maxPairForm y1 y2 y3
  have hbound34 : pairForm34 y1 y2 y3 ≤ pairForm12 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm34_le_maxPairForm y1 y2 y3
  have h0 : 0 ≤ dominance0 y1 y2 y3 := by
    rw [dominance0_eq]
    linarith [hbound01]
  have h1 : 0 ≤ dominance1 y1 y2 y3 := by
    rw [dominance1_eq]
    linarith [hbound02]
  have h2 : 0 ≤ dominance2 y1 y2 y3 := by
    rw [dominance2_eq]
    linarith [hbound03]
  have h3 : 0 ≤ dominance3 y1 y2 y3 := by
    rw [dominance3_eq]
    linarith [hbound04]
  have h4 : 0 ≤ dominance4 y1 y2 y3 := by
    rw [dominance4_eq]
    linarith [hbound13]
  have h5 : 0 ≤ dominance5 y1 y2 y3 := by
