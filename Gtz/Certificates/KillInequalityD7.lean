    exact pairForm14_le_maxPairForm y1 y2 y3
  have hbound23 : pairForm23 y1 y2 y3 ≤ pairForm04 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm23_le_maxPairForm y1 y2 y3
  have hbound24 : pairForm24 y1 y2 y3 ≤ pairForm04 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm24_le_maxPairForm y1 y2 y3
  have hbound34 : pairForm34 y1 y2 y3 ≤ pairForm04 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm34_le_maxPairForm y1 y2 y3
  have h0 : 0 ≤ dominance0 y1 y2 y3 := by
    rw [dominance0_eq]
    linarith [hbound01]
  have h1 : 0 ≤ dominance1 y1 y2 y3 := by
    rw [dominance1_eq]
    linarith [hbound02]
  have h2 : 0 ≤ dominance2 y1 y2 y3 := by
    rw [dominance2_eq]
    linarith [hbound03]
  have h3 : 0 ≤ dominance3 y1 y2 y3 := by
    rw [dominance3_eq]
    linarith [hbound12]
  have h4 : 0 ≤ dominance4 y1 y2 y3 := by
    rw [dominance4_eq]
    linarith [hbound13]
  have h5 : 0 ≤ dominance5 y1 y2 y3 := by
    rw [dominance5_eq]
    linarith [hbound14]
  have h6 : 0 ≤ dominance6 y1 y2 y3 := by
    rw [dominance6_eq]
    linarith [hbound23]
  have h7 : 0 ≤ dominance7 y1 y2 y3 := by
    rw [dominance7_eq]
    linarith [hbound24]
  have h8 : 0 ≤ dominance8 y1 y2 y3 := by
    rw [dominance8_eq]
    linarith [hbound34]
  have h9 : 0 ≤ dominance9 y1 y2 y3 := by
    rw [dominance9_eq]
    linarith [hsplit]
  have htarget : 0 ≤ targetForm y1 y2 y3 :=
    targetForm_nonneg_on_cell y1 y2 y3 hne h0 h1 h2 h3 h4 h5 h6 h7 h8 h9
  rw [targetForm_eq] at htarget
  rw [hdominant]
  linarith [htarget]

end Cell04B

