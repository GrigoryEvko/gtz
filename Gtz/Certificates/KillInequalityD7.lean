  have h7 : 0 ≤ dominance7 y1 y2 y3 := by
    rw [dominance7_eq]
    linarith [hbound24]
  have h8 : 0 ≤ dominance8 y1 y2 y3 := by
    rw [dominance8_eq]
    linarith [hbound34]
  have htarget : 0 ≤ targetForm y1 y2 y3 :=
    targetForm_nonneg_on_cell y1 y2 y3 hne h0 h1 h2 h3 h4 h5 h6 h7 h8
  rw [targetForm_eq] at htarget
  rw [hdominant]
  linarith [htarget]

