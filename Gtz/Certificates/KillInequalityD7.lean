  + 51930 * (y2 + (248 / 1731) * y3) ^ 2
  + (285080 / 577) * (y3) ^ 2

/-- The sum-of-squares remainder: a quartic, in its exact LDL form
over the six quadratic monomials. -/
def sosRemainder (y1 y2 y3 : ℝ) : ℝ :=
  381925 * (y2 ^ 2 - (21162 / 76385) * y3 ^ 2 + (15897 / 76385) * y1 * y2 - (21162 / 76385) * y1 * y3 + (55223 / 76385) * y2 * y3) ^ 2
  + (2327236806 / 15277) * (y3 ^ 2 + (525764342 / 1163618403) * y1 * y2 + y1 * y3 + y2 * y3) ^ 2
  + (214341545222920 / 1163618403) * (y1 * y2) ^ 2

theorem weightFormFromThird_eq (y1 y2 y3 : ℝ) :
    weightFormFromThird y1 y2 y3 = weightForm y1 y2 y3 := by
  unfold weightFormFromThird weightForm; ring

theorem weightFormFromSecond_eq (y1 y2 y3 : ℝ) :
