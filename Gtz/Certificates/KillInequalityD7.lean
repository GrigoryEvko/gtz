/-- **The cell theorem.** -/
theorem targetForm_nonneg_on_cell (y1 y2 y3 : ℝ)
    (hne : y1 ≠ 0 ∨ y2 ≠ 0 ∨ y3 ≠ 0)
    (h0 : 0 ≤ dominance0 y1 y2 y3)
    (h1 : 0 ≤ dominance1 y1 y2 y3)
    (h2 : 0 ≤ dominance2 y1 y2 y3)
    (h3 : 0 ≤ dominance3 y1 y2 y3)
    (h4 : 0 ≤ dominance4 y1 y2 y3)
    (h5 : 0 ≤ dominance5 y1 y2 y3)
    (h6 : 0 ≤ dominance6 y1 y2 y3)
    (h7 : 0 ≤ dominance7 y1 y2 y3)
    (h8 : 0 ≤ dominance8 y1 y2 y3)
    (h9 : 0 ≤ dominance9 y1 y2 y3)
    : 0 ≤ targetForm y1 y2 y3 := by
  have hweight : 0 < weightForm y1 y2 y3 :=
    weightForm_pos_of_ne_zero y1 y2 y3 hne
  have hsos : 0 ≤ sosRemainder y1 y2 y3 := sosRemainder_nonneg _ _ _
  have hterm0 : 0 ≤ multiplier0 y1 y2 y3 * dominance0 y1 y2 y3 :=
    mul_nonneg (multiplier0_nonneg _ _ _) h0
  have hterm1 : 0 ≤ multiplier1 y1 y2 y3 * dominance1 y1 y2 y3 :=
    mul_nonneg (multiplier1_nonneg _ _ _) h1
  have hterm2 : 0 ≤ multiplier2 y1 y2 y3 * dominance2 y1 y2 y3 :=
    mul_nonneg (multiplier2_nonneg _ _ _) h2
  have hterm3 : 0 ≤ multiplier3 y1 y2 y3 * dominance3 y1 y2 y3 :=
    mul_nonneg (multiplier3_nonneg _ _ _) h3
  have hterm4 : 0 ≤ multiplier4 y1 y2 y3 * dominance4 y1 y2 y3 :=
    mul_nonneg (multiplier4_nonneg _ _ _) h4
  have hterm5 : 0 ≤ multiplier5 y1 y2 y3 * dominance5 y1 y2 y3 :=
    mul_nonneg (multiplier5_nonneg _ _ _) h5
  have hterm6 : 0 ≤ multiplier6 y1 y2 y3 * dominance6 y1 y2 y3 :=
    mul_nonneg (multiplier6_nonneg _ _ _) h6
  have hterm7 : 0 ≤ multiplier7 y1 y2 y3 * dominance7 y1 y2 y3 :=
    mul_nonneg (multiplier7_nonneg _ _ _) h7
  have hterm8 : 0 ≤ multiplier8 y1 y2 y3 * dominance8 y1 y2 y3 :=
    mul_nonneg (multiplier8_nonneg _ _ _) h8
  have hterm9 : 0 ≤ multiplier9 y1 y2 y3 * dominance9 y1 y2 y3 :=
    mul_nonneg (multiplier9_nonneg _ _ _) h9
  have hproduct : 0 ≤ weightForm y1 y2 y3 * targetForm y1 y2 y3 := by
    rw [certificate_identity]
    linarith
  exact nonneg_of_mul_nonneg_right hproduct hweight

/-- The scaling that carries the cell target to the shared
vocabulary; the factor is positive, so it preserves sign. -/
theorem targetForm_eq (y1 y2 y3 : ℝ) :
    targetForm y1 y2 y3 = 2 * (60 * pairForm02 y1 y2 y3
      - ellipsoidFormA y1 y2 y3) := by
  unfold targetForm pairForm02 ellipsoidFormA; ring

theorem dominance0_eq (y1 y2 y3 : ℝ) :
    dominance0 y1 y2 y3 = 24 * (pairForm02 y1 y2 y3
      - pairForm01 y1 y2 y3) := by
  unfold dominance0 pairForm02 pairForm01; ring

theorem dominance1_eq (y1 y2 y3 : ℝ) :
    dominance1 y1 y2 y3 = 24 * (pairForm02 y1 y2 y3
      - pairForm03 y1 y2 y3) := by
  unfold dominance1 pairForm02 pairForm03; ring

theorem dominance2_eq (y1 y2 y3 : ℝ) :
    dominance2 y1 y2 y3 = 24 * (pairForm02 y1 y2 y3
      - pairForm04 y1 y2 y3) := by
  unfold dominance2 pairForm02 pairForm04; ring

theorem dominance3_eq (y1 y2 y3 : ℝ) :
    dominance3 y1 y2 y3 = 24 * (pairForm02 y1 y2 y3
      - pairForm12 y1 y2 y3) := by
  unfold dominance3 pairForm02 pairForm12; ring

theorem dominance4_eq (y1 y2 y3 : ℝ) :
    dominance4 y1 y2 y3 = 24 * (pairForm02 y1 y2 y3
      - pairForm13 y1 y2 y3) := by
  unfold dominance4 pairForm02 pairForm13; ring

theorem dominance5_eq (y1 y2 y3 : ℝ) :
    dominance5 y1 y2 y3 = 24 * (pairForm02 y1 y2 y3
      - pairForm14 y1 y2 y3) := by
  unfold dominance5 pairForm02 pairForm14; ring

theorem dominance6_eq (y1 y2 y3 : ℝ) :
    dominance6 y1 y2 y3 = 24 * (pairForm02 y1 y2 y3
      - pairForm23 y1 y2 y3) := by
  unfold dominance6 pairForm02 pairForm23; ring

theorem dominance7_eq (y1 y2 y3 : ℝ) :
    dominance7 y1 y2 y3 = 24 * (pairForm02 y1 y2 y3
      - pairForm24 y1 y2 y3) := by
  unfold dominance7 pairForm02 pairForm24; ring

theorem dominance8_eq (y1 y2 y3 : ℝ) :
    dominance8 y1 y2 y3 = 8 * (pairForm02 y1 y2 y3
      - pairForm34 y1 y2 y3) := by
  unfold dominance8 pairForm02 pairForm34; ring

theorem dominance9_eq (y1 y2 y3 : ℝ) :
    dominance9 y1 y2 y3 = 1 * (y1 ^ 2 - y3 ^ 2) := by
  unfold dominance9; ring

/-- **The cell conclusion.** -/
theorem ellipsoidFormA_le_of_dominant (y1 y2 y3 : ℝ)
    (hne : y1 ≠ 0 ∨ y2 ≠ 0 ∨ y3 ≠ 0)
    (hdominant : maxPairForm y1 y2 y3 = pairForm02 y1 y2 y3)
    (hseparator : y3 ^ 2 ≤ y1 ^ 2) :
    ellipsoidFormA y1 y2 y3 ≤ 60 * maxPairForm y1 y2 y3 := by
  have hbound01 : pairForm01 y1 y2 y3 ≤ pairForm02 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm01_le_maxPairForm y1 y2 y3
  have hbound03 : pairForm03 y1 y2 y3 ≤ pairForm02 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm03_le_maxPairForm y1 y2 y3
  have hbound04 : pairForm04 y1 y2 y3 ≤ pairForm02 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm04_le_maxPairForm y1 y2 y3
  have hbound12 : pairForm12 y1 y2 y3 ≤ pairForm02 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm12_le_maxPairForm y1 y2 y3
  have hbound13 : pairForm13 y1 y2 y3 ≤ pairForm02 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm13_le_maxPairForm y1 y2 y3
  have hbound14 : pairForm14 y1 y2 y3 ≤ pairForm02 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm14_le_maxPairForm y1 y2 y3
  have hbound23 : pairForm23 y1 y2 y3 ≤ pairForm02 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm23_le_maxPairForm y1 y2 y3
  have hbound24 : pairForm24 y1 y2 y3 ≤ pairForm02 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm24_le_maxPairForm y1 y2 y3
  have hbound34 : pairForm34 y1 y2 y3 ≤ pairForm02 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm34_le_maxPairForm y1 y2 y3
  have h0 : 0 ≤ dominance0 y1 y2 y3 := by
    rw [dominance0_eq]
    linarith [hbound01]
  have h1 : 0 ≤ dominance1 y1 y2 y3 := by
    rw [dominance1_eq]
    linarith [hbound03]
  have h2 : 0 ≤ dominance2 y1 y2 y3 := by
    rw [dominance2_eq]
    linarith [hbound04]
  have h3 : 0 ≤ dominance3 y1 y2 y3 := by
    rw [dominance3_eq]
    linarith [hbound12]
  have h4 : 0 ≤ dominance4 y1 y2 y3 := by
    rw [dominance4_eq]
    linarith [hbound13]
  have h5 : 0 ≤ dominance5 y1 y2 y3 := by
    rw [dominance5_eq]
    linarith [hbound14]
  have h6 : 0 ≤ dominance6 y1 y2 y3 := by
    rw [dominance6_eq]
    linarith [hbound23]
  have h7 : 0 ≤ dominance7 y1 y2 y3 := by
    rw [dominance7_eq]
    linarith [hbound24]
  have h8 : 0 ≤ dominance8 y1 y2 y3 := by
    rw [dominance8_eq]
    linarith [hbound34]
  have h9 : 0 ≤ dominance9 y1 y2 y3 := by
    rw [dominance9_eq]
    linarith [hseparator]
  have htarget : 0 ≤ targetForm y1 y2 y3 :=
    targetForm_nonneg_on_cell y1 y2 y3 hne h0 h1 h2 h3 h4 h5 h6 h7 h8 h9
  rw [targetForm_eq] at htarget
  rw [hdominant]
  linarith [htarget]

end CellSix02APlus

