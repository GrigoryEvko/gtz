    (hne : y1 ≠ 0 ∨ y2 ≠ 0 ∨ y3 ≠ 0)
    (hdominant : maxPairForm y1 y2 y3 = pairForm34 y1 y2 y3)
    (hseparator : y3 ^ 2 ≤ y1 ^ 2) :
    ellipsoidFormA y1 y2 y3 ≤ 60 * maxPairForm y1 y2 y3 := by
