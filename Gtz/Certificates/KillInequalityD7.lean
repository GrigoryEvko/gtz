/-! ## Dominance cell of the pair `(0, 3)` with
the `A` ellipsoid as target. -/
namespace Cell03A

open KillFormsD7

/-- The cell target `60 * b_03 - q_A`, scaled by `1`. -/
def targetForm (y1 y2 y3 : ℝ) : ℝ :=
  - 30 * y1 ^ 2 - 50 * y1 * y2 - 30 * y1 * y3 - 50 * y2 ^ 2 - 50 * y2 * y3

/-- Dominance quadric 0: `b_03 - b_01`, scaled by `6`. -/
def dominance0 (y1 y2 y3 : ℝ) : ℝ :=
  - 3 * y1 ^ 2 - 4 * y1 * y2 - 12 * y1 * y3 - 16 * y2 * y3

/-- Dominance quadric 1: `b_03 - b_02`, scaled by `24`. -/
def dominance1 (y1 y2 y3 : ℝ) : ℝ :=
  - 12 * y1 ^ 2 - 40 * y1 * y2 - 48 * y1 * y3 - 25 * y2 ^ 2 - 40 * y2 * y3

/-- Dominance quadric 2: `b_03 - b_04`, scaled by `6`. -/
def dominance2 (y1 y2 y3 : ℝ) : ℝ :=
  - 3 * y1 ^ 2 - 8 * y1 * y2 - 5 * y2 ^ 2 - 2 * y2 * y3 + 3 * y3 ^ 2

/-- Dominance quadric 3: `b_03 - b_12`, scaled by `6`. -/
def dominance3 (y1 y2 y3 : ℝ) : ℝ :=
  - 3 * y1 ^ 2 - 16 * y1 * y2 - 12 * y1 * y3 - 4 * y2 * y3

/-- Dominance quadric 4: `b_03 - b_13`, scaled by `6`. -/
def dominance4 (y1 y2 y3 : ℝ) : ℝ :=
  1 * y1 ^ 2 + 4 * y1 * y2 + 8 * y1 * y3 + 16 * y2 * y3 + 16 * y3 ^ 2

/-- Dominance quadric 5: `b_03 - b_14`, scaled by `6`. -/
def dominance5 (y1 y2 y3 : ℝ) : ℝ :=
  13 * y1 ^ 2 + 16 * y1 * y2 + 8 * y1 * y3 + 4 * y2 * y3 + 4 * y3 ^ 2

/-- Dominance quadric 6: `b_03 - b_23`, scaled by `6`. -/
def dominance6 (y1 y2 y3 : ℝ) : ℝ :=
  - 2 * y1 * y2 - 5 * y2 ^ 2 - 8 * y2 * y3

/-- Dominance quadric 7: `b_03 - b_24`, scaled by `2`. -/
def dominance7 (y1 _y2 y3 : ℝ) : ℝ :=
  - 1 * y1 ^ 2 + 1 * y3 ^ 2

/-- Dominance quadric 8: `b_03 - b_34`, scaled by `24`. -/
def dominance8 (y1 y2 y3 : ℝ) : ℝ :=
  3 * y1 ^ 2 - 10 * y1 * y2 - 18 * y1 * y3 - 25 * y2 ^ 2 - 10 * y2 * y3 + 15 * y3 ^ 2

/-- Dominance quadric 9: `q_B - q_A, the half-split quadric`, scaled by `1`. -/
def dominance9 (y1 y2 y3 : ℝ) : ℝ :=
  10 * y1 * y2 + 10 * y2 ^ 2 + 10 * y2 * y3

/-- The certificate weight: a positive definite quadratic form, in
its exact LDL sum-of-squares form (elimination order 1, 2, 3, so
the last term is a positive multiple of `y3 ^ 2`). -/
def weightForm (y1 y2 y3 : ℝ) : ℝ :=
  7636 * (y1 + (1530 / 1909) * y2 - (60 / 83) * y3) ^ 2
  + (1594060 / 1909) * (y2 - (24426 / 79703) * y3) ^ 2
  + (48396748 / 79703) * (y3) ^ 2

/-- The same weight, eliminated in the order 3, 2, 1: the last term
is a positive multiple of `y1 ^ 2`. -/
def weightFormFromThird (y1 y2 y3 : ℝ) : ℝ :=
  4676 * (- (1380 / 1169) * y1 - (1170 / 1169) * y2 + y3) ^ 2
  + (1234460 / 1169) * ((34794 / 61723) * y1 + y2) ^ 2
  + (48396748 / 61723) * (y1) ^ 2

/-- The same weight, eliminated in the order 1, 3, 2: the last term
is a positive multiple of `y2 ^ 2`. -/
def weightFormFromSecond (y1 y2 y3 : ℝ) : ℝ :=
  7636 * (y1 + (1530 / 1909) * y2 - (60 / 83) * y3) ^ 2
  + (56908 / 83) * (- (5310 / 14227) * y2 + y3) ^ 2
  + (241983740 / 327221) * (y2) ^ 2

/-- Multiplier for dominance quadric 0, as a sum of squares. -/
def multiplier0 (y1 y2 y3 : ℝ) : ℝ :=
  70 * (y1 + y2 + y3) ^ 2

/-- Multiplier for dominance quadric 1, as a sum of squares. -/
def multiplier1 (y1 y2 y3 : ℝ) : ℝ :=
  2885 * (y1 + y2 + y3) ^ 2

/-- Multiplier for dominance quadric 2, as a sum of squares. -/
def multiplier2 (y1 y2 _y3 : ℝ) : ℝ :=
  82320 * (y1 + (2993 / 4116) * y2) ^ 2
  + (177055 / 1029) * (y2) ^ 2

/-- Multiplier for dominance quadric 3, as a sum of squares. -/
def multiplier3 (y1 y2 y3 : ℝ) : ℝ :=
  80 * (y1 + y2 + y3) ^ 2

/-- Multiplier for dominance quadric 4, as a sum of squares. -/
def multiplier4 (_y1 y2 _y3 : ℝ) : ℝ :=
  49280 * (y2) ^ 2

/-- Multiplier for dominance quadric 5, as a sum of squares. -/
def multiplier5 (_y1 y2 _y3 : ℝ) : ℝ :=
  80 * (y2) ^ 2

/-- Multiplier for dominance quadric 6, as a sum of squares. -/
def multiplier6 (y1 y2 y3 : ℝ) : ℝ :=
  12340 * (y1 - (974 / 617) * y2 - (974 / 617) * y3) ^ 2
  + (165820 / 617) * (y2 + y3) ^ 2

/-- Multiplier for dominance quadric 7, as a sum of squares. -/
def multiplier7 (y1 _y2 _y3 : ℝ) : ℝ :=
  103320 * (y1) ^ 2

/-- Multiplier for dominance quadric 8, as a sum of squares. -/
def multiplier8 (_y1 y2 _y3 : ℝ) : ℝ :=
  20 * (y2) ^ 2

/-- Multiplier for dominance quadric 9, as a sum of squares. -/
def multiplier9 (y1 y2 y3 : ℝ) : ℝ :=
  47760 * (y1 - (11 / 398) * y2 + (102 / 199) * y3) ^ 2
  + (88260 / 199) * (y2 - (144 / 1471) * y3) ^ 2
  + (835840 / 1471) * (y3) ^ 2

/-- The sum-of-squares remainder: a quartic, in its exact LDL form
over the six quadratic monomials. -/
def sosRemainder (y1 y2 y3 : ℝ) : ℝ :=
  156270 * (y1 ^ 2 + (10 / 5209) * y2 ^ 2 + (145 / 15627) * y1 * y2 + y1 * y3 + (10 / 5209) * y2 * y3) ^ 2
  + (804396825 / 5209) * (y2 ^ 2 + (108809 / 32175873) * y1 * y2 + y2 * y3) ^ 2
  + (5056753113800 / 32175873) * (y1 * y2) ^ 2

theorem weightFormFromThird_eq (y1 y2 y3 : ℝ) :
