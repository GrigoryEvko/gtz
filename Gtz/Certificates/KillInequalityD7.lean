  have hbound03 : pairForm03 y1 y2 y3 ≤ pairForm01 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm03_le_maxPairForm y1 y2 y3
  have hbound04 : pairForm04 y1 y2 y3 ≤ pairForm01 y1 y2 y3 := by
