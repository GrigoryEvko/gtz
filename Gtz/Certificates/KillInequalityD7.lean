/-- **The cell conclusion.**  When the maximum of the ten pair
forms is attained at `b_24`,
the value of `q_B` is bounded by
sixty times the maximum. -/
theorem ellipsoidFormB_le_of_dominant (y1 y2 y3 : ℝ)
    (hne : y1 ≠ 0 ∨ y2 ≠ 0 ∨ y3 ≠ 0)
    (hdominant : maxPairForm y1 y2 y3 = pairForm24 y1 y2 y3) :
    ellipsoidFormB y1 y2 y3 ≤ 60 * maxPairForm y1 y2 y3 := by
  have hbound01 : pairForm01 y1 y2 y3 ≤ pairForm24 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm01_le_maxPairForm y1 y2 y3
  have hbound02 : pairForm02 y1 y2 y3 ≤ pairForm24 y1 y2 y3 := by
    rw [← hdominant]
    exact pairForm02_le_maxPairForm y1 y2 y3
  have hbound03 : pairForm03 y1 y2 y3 ≤ pairForm24 y1 y2 y3 := by
    rw [← hdominant]
