def sosRemainder (y1 y2 y3 : ℝ) : ℝ :=
  306250 * (y2 ^ 2 - (51 / 6125) * y3 ^ 2 + y1 * y2 - (51 / 6125) * y1 * y3 - (3 / 6125) * y2 * y3) ^ 2
  + (75887223 / 245) * (y3 ^ 2 + y1 * y3 + (89119 / 75887223) * y2 * y3) ^ 2
  + (23864596460410 / 75887223) * (y2 * y3) ^ 2

