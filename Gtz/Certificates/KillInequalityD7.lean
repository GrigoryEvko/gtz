theorem forms_vanish_at_origin :
    ellipsoidFormA 0 0 0 = 0 ∧ ellipsoidFormB 0 0 0 = 0 ∧
      maxPairForm 0 0 0 = 0 := by
  refine ⟨?_, ?_, ?_⟩
  · unfold ellipsoidFormA; norm_num
  · unfold ellipsoidFormB; norm_num
  · unfold maxPairForm runningMaxFrom02 runningMaxFrom03 runningMaxFrom04 runningMaxFrom12 runningMaxFrom13 runningMaxFrom14 runningMaxFrom23 runningMaxFrom24 runningMaxFrom34
    unfold pairForm01 pairForm02 pairForm03 pairForm04 pairForm12 pairForm13 pairForm14 pairForm23 pairForm24 pairForm34
    norm_num

/-- **The kill inequality.**  For every direction, the smaller of the
two dual-ray ellipsoid values is at most sixty times the largest pair
form.  Equality holds exactly on the five split rays, where both
ellipsoids take the value `60` and the largest pair form is `1`. -/
theorem killInequality (y1 y2 y3 : ℝ) :
    min (ellipsoidFormA y1 y2 y3) (ellipsoidFormB y1 y2 y3)
      ≤ 60 * maxPairForm y1 y2 y3 := by
  by_cases horigin : y1 = 0 ∧ y2 = 0 ∧ y3 = 0
  · obtain ⟨hfirst, hsecond, hthird⟩ := horigin
    subst hfirst; subst hsecond; subst hthird
    obtain ⟨hA, hB, hmax⟩ := forms_vanish_at_origin
    rw [hA, hB, hmax]
    norm_num
  · have hne : y1 ≠ 0 ∨ y2 ≠ 0 ∨ y3 ≠ 0 := by
      rcases eq_or_ne y1 0 with hfirst | hfirst
      · rcases eq_or_ne y2 0 with hsecond | hsecond
        · rcases eq_or_ne y3 0 with hthird | hthird
          · exact absurd ⟨hfirst, hsecond, hthird⟩ horigin
          · exact Or.inr (Or.inr hthird)
        · exact Or.inr (Or.inl hsecond)
      · exact Or.inl hfirst
    rcases maxPairForm_cases y1 y2 y3 with hdominant | hdominant | hdominant | hdominant | hdominant | hdominant | hdominant | hdominant | hdominant | hdominant
    · rcases le_total (ellipsoidFormA y1 y2 y3) (ellipsoidFormB y1 y2 y3) with hsplit | hsplit
      · rw [min_eq_left hsplit]
        exact Cell01A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
      · rw [min_eq_right hsplit]
        exact Cell01B.ellipsoidFormB_le_of_dominant y1 y2 y3 hne hdominant
    · rcases le_total (ellipsoidFormA y1 y2 y3) (ellipsoidFormB y1 y2 y3) with hsplit | hsplit
      · rw [min_eq_left hsplit]
        exact Cell02A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant hsplit
      · rw [min_eq_right hsplit]
        exact Cell02B.ellipsoidFormB_le_of_dominant y1 y2 y3 hne hdominant hsplit
    · rcases le_total (ellipsoidFormA y1 y2 y3) (ellipsoidFormB y1 y2 y3) with hsplit | hsplit
      · rw [min_eq_left hsplit]
        exact Cell03A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant hsplit
      · rw [min_eq_right hsplit]
        exact Cell03B.ellipsoidFormB_le_of_dominant y1 y2 y3 hne hdominant
    · rcases le_total (ellipsoidFormA y1 y2 y3) (ellipsoidFormB y1 y2 y3) with hsplit | hsplit
      · rw [min_eq_left hsplit]
        exact Cell04A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
      · rw [min_eq_right hsplit]
        exact Cell04B.ellipsoidFormB_le_of_dominant y1 y2 y3 hne hdominant hsplit
    · rcases le_total (ellipsoidFormA y1 y2 y3) (ellipsoidFormB y1 y2 y3) with hsplit | hsplit
      · rw [min_eq_left hsplit]
        exact Cell12A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
      · rw [min_eq_right hsplit]
        exact Cell12B.ellipsoidFormB_le_of_dominant y1 y2 y3 hne hdominant
    · rcases le_total (ellipsoidFormA y1 y2 y3) (ellipsoidFormB y1 y2 y3) with hsplit | hsplit
      · rw [min_eq_left hsplit]
        exact Cell13A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
      · rw [min_eq_right hsplit]
        exact Cell13B.ellipsoidFormB_le_of_dominant y1 y2 y3 hne hdominant
    · rcases le_total (ellipsoidFormA y1 y2 y3) (ellipsoidFormB y1 y2 y3) with hsplit | hsplit
      · rw [min_eq_left hsplit]
        exact Cell14A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
      · rw [min_eq_right hsplit]
        exact Cell14B.ellipsoidFormB_le_of_dominant y1 y2 y3 hne hdominant
    · rcases le_total (ellipsoidFormA y1 y2 y3) (ellipsoidFormB y1 y2 y3) with hsplit | hsplit
      · rw [min_eq_left hsplit]
        exact Cell23A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
      · rw [min_eq_right hsplit]
        exact Cell23B.ellipsoidFormB_le_of_dominant y1 y2 y3 hne hdominant hsplit
    · rcases le_total (ellipsoidFormA y1 y2 y3) (ellipsoidFormB y1 y2 y3) with hsplit | hsplit
      · rw [min_eq_left hsplit]
        exact Cell24A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant hsplit
      · rw [min_eq_right hsplit]
        exact Cell24B.ellipsoidFormB_le_of_dominant y1 y2 y3 hne hdominant
    · rcases le_total (ellipsoidFormA y1 y2 y3) (ellipsoidFormB y1 y2 y3) with hsplit | hsplit
      · rw [min_eq_left hsplit]
        exact Cell34A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant hsplit
      · rw [min_eq_right hsplit]
        exact Cell34B.ellipsoidFormB_le_of_dominant y1 y2 y3 hne hdominant hsplit

/-- **The single-ellipsoid kill inequality**, strictly stronger than
the two-ellipsoid form: the FIRST dual-ray ellipsoid alone is already
dominated by the ten pair rescues, so the minimum over the two is
decoration.  Twelve pieces: six dominance cells whole at degree four,
`(0,3)` and `(2,4)` whole at degree six, and `(0,2)`, `(3,4)` each
separated by `y1 ^ 2 - y3 ^ 2` into two degree-six pieces.  That
separator isolates the extra rational zeros `(5, -6, 7)` and
`(7, -6, 5)` of the A-form, where the inequality is tight at `738`
with three pair forms tied at the maximum. -/
theorem killInequalityStrong (y1 y2 y3 : ℝ) :
    ellipsoidFormA y1 y2 y3 ≤ 60 * maxPairForm y1 y2 y3 := by
  by_cases horigin : y1 = 0 ∧ y2 = 0 ∧ y3 = 0
  · obtain ⟨hfirst, hsecond, hthird⟩ := horigin
    subst hfirst; subst hsecond; subst hthird
    obtain ⟨hA, _, hmax⟩ := forms_vanish_at_origin
    rw [hA, hmax]
    norm_num
  · have hne : y1 ≠ 0 ∨ y2 ≠ 0 ∨ y3 ≠ 0 := by
      rcases eq_or_ne y1 0 with hfirst | hfirst
      · rcases eq_or_ne y2 0 with hsecond | hsecond
        · rcases eq_or_ne y3 0 with hthird | hthird
          · exact absurd ⟨hfirst, hsecond, hthird⟩ horigin
          · exact Or.inr (Or.inr hthird)
        · exact Or.inr (Or.inl hsecond)
      · exact Or.inl hfirst
    rcases maxPairForm_cases y1 y2 y3 with hdominant | hdominant | hdominant | hdominant | hdominant | hdominant | hdominant | hdominant | hdominant | hdominant
    · exact Cell01A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
    · rcases le_total (y1 ^ 2) (y3 ^ 2) with hseparator | hseparator
      · exact CellSix02AMinus.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant hseparator
      · exact CellSix02APlus.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant hseparator
    · exact CellSix03A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
    · exact Cell04A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
    · exact Cell12A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
    · exact Cell13A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
    · exact Cell14A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
    · exact Cell23A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
    · exact CellSix24A.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant
    · rcases le_total (y1 ^ 2) (y3 ^ 2) with hseparator | hseparator
      · exact CellSix34AMinus.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant hseparator
      · exact CellSix34APlus.ellipsoidFormA_le_of_dominant y1 y2 y3 hne hdominant hseparator

/-- The two-ellipsoid inequality is a corollary of the
single-ellipsoid one, giving an independent second proof of it that
does not use the ten `B`-target cells. -/
theorem killInequality_of_strong (y1 y2 y3 : ℝ) :
    min (ellipsoidFormA y1 y2 y3) (ellipsoidFormB y1 y2 y3)
      ≤ 60 * maxPairForm y1 y2 y3 :=
  le_trans (min_le_left _ _) (killInequalityStrong y1 y2 y3)

/-- The five incidence directions of the canonical diamond, grounded
gauge, as coordinate triples. -/
def incidenceTriple : Fin 5 → ℝ × ℝ × ℝ
  | 0 => (1, (-1), 0)
  | 1 => (1, 0, (-1))
  | 2 => (0, 1, (-1))
  | 3 => (1, 0, 0)
  | 4 => (0, 0, (-1))

/-- The squared scales `5·c_e` of the split anchors `u_e = √(5c_e)·r_e`. -/
def squaredScale : Fin 5 → ℝ
  | 0 => 5
  | 1 => (10 / 3)
  | 2 => 5
  | 3 => 5
  | 4 => 5

/-- Both ellipsoids take the value `60` at every split anchor: the
split-tie family is exactly the flat locus of the obstruction. -/
theorem ellipsoid_anchor_exact (edge : Fin 5) :
    squaredScale edge * ellipsoidFormA (incidenceTriple edge).1
        (incidenceTriple edge).2.1 (incidenceTriple edge).2.2 = 60 ∧
      squaredScale edge * ellipsoidFormB (incidenceTriple edge).1
        (incidenceTriple edge).2.1 (incidenceTriple edge).2.2 = 60 := by
  fin_cases edge <;>
    refine ⟨?_, ?_⟩ <;>
    simp only [squaredScale, incidenceTriple, ellipsoidFormA,
      ellipsoidFormB] <;>
    norm_num

/-- At every split anchor the largest pair form is exactly `1`, so the
kill inequality is tight there: `60 = 60 * 1`. -/
theorem maxPairForm_anchor_exact (edge : Fin 5) :
    squaredScale edge * maxPairForm (incidenceTriple edge).1
      (incidenceTriple edge).2.1 (incidenceTriple edge).2.2 = 1 := by
  fin_cases edge <;>
    simp only [squaredScale, incidenceTriple, maxPairForm,
      runningMaxFrom02, runningMaxFrom03, runningMaxFrom04, runningMaxFrom12, runningMaxFrom13, runningMaxFrom14, runningMaxFrom23, runningMaxFrom24, runningMaxFrom34,
      pairForm01, pairForm02, pairForm03, pairForm04, pairForm12, pairForm13, pairForm14, pairForm23, pairForm24, pairForm34] <;>
    norm_num

/-- The ellipsoid vocabulary agrees with the anchor matrices: the
first dual-ray ellipsoid is `1 / 440` times the integer matrix form. -/
theorem ellipsoidFormA_eq_matrixForm (y1 y2 y3 : ℝ) :
    440 * ellipsoidFormA y1 y2 y3 =
      ![y1, y2, y3] ⬝ᵥ Matrix.mulVec
        (!![5280, 2200, 1320; 2200, 4400, 2200; 1320, 2200, 5280] :
          Matrix (Fin 3) (Fin 3) ℝ) ![y1, y2, y3] := by
  unfold ellipsoidFormA
  simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_three,
    Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.head_fin_const, Matrix.cons_val_fin_one,
    Matrix.of_apply, Matrix.cons_val_two, Matrix.tail_cons]
  ring

/-- The same agreement for the second dual-ray ellipsoid. -/
theorem ellipsoidFormB_eq_matrixForm (y1 y2 y3 : ℝ) :
    440 * ellipsoidFormB y1 y2 y3 =
      ![y1, y2, y3] ⬝ᵥ Matrix.mulVec
        (!![5280, 4400, 1320; 4400, 8800, 4400; 1320, 4400, 5280] :
          Matrix (Fin 3) (Fin 3) ℝ) ![y1, y2, y3] := by
  unfold ellipsoidFormB
  simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_three,
    Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.head_fin_const, Matrix.cons_val_fin_one,
    Matrix.of_apply, Matrix.cons_val_two, Matrix.tail_cons]
  ring

end KillFormsD7

