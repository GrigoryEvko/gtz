/-- The cell target `60 * b_04 - q_A`, scaled by `1`. -/
def targetForm (y1 y2 y3 : ℝ) : ℝ :=
  30 * y1 * y2 - 30 * y1 * y3 - 30 * y2 * y3 - 30 * y3 ^ 2

/-- Dominance quadric 0: `b_04 - b_01`, scaled by `6`. -/
def dominance0 (y1 y2 y3 : ℝ) : ℝ :=
  4 * y1 * y2 - 12 * y1 * y3 + 5 * y2 ^ 2 - 14 * y2 * y3 - 3 * y3 ^ 2

