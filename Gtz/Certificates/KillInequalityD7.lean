import Mathlib

/-!
# The kill inequality of the canonical (5,3) diamond, in kernel

At the canonical (5,3) diamond tie the first-order obstruction is the
kill inequality

  `min (yᵀ A_A y) (yᵀ A_B y) ≤ 60 * max_ij yᵀ B_ij y`   for every `y`,

relating the two dual-ray ellipsoids `A_A`, `A_B` to the ten pair forms
`B_ij` of the diamond.  The five split directions `u_e = √(5c_e)·r_e`
realise equality: both quadrics take the value `60` there while the
largest pair form takes the value `1`.

The proof splits over the ten dominance cells
`C_ij = {y | b_ij y ≥ b_kl y for every pair kl}`, each halved by the
sign of `q_B - q_A`.  On each of the resulting twenty cells a positive
multiple of that cell's target is a nonnegative combination of the
cell's defining quadrics plus a sum of squares,

  `weightForm * targetForm = Σ multiplierₖ * dominanceₖ + sosRemainder`,

an identity of rational polynomials closed by `ring`.  Every multiplier
and the remainder are written as sums of squares with nonnegative
rational coefficients -- exact LDL factorisations of the certificate's
Gram blocks -- so their nonnegativity is `positivity`.  The weight is
positive definite, hence strictly positive off the origin; three LDL
orderings supply one usable decomposition per nonzero coordinate.  So
each cell target is nonnegative wherever every dominance quadric is,
which is exactly that cell.

The twenty cells cover: the running maximum of the ten pair forms is
attained at one of them, and the two ellipsoid values are comparable.
Assembling the attained pair with the comparison direction lands in a
cell whose target bounds the smaller ellipsoid, which is the theorem.

All cell forms are scaled by positive rationals to integer
coefficients; that changes no sign, and each scaling is exhibited by a
bridge lemma back to the shared vocabulary.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

-- The forms carry rational coefficients but live on real directions, so
-- their definitions use real division and are not executable.
noncomputable section

namespace Gtz

namespace KillFormsD7

/-- The first dual-ray ellipsoid `q_A`, normalised so that every split
direction has value `60`. -/
def ellipsoidFormA (y1 y2 y3 : ℝ) : ℝ :=
  12 * y1 ^ 2 + 10 * y1 * y2 + 6 * y1 * y3 + 10 * y2 ^ 2 + 10 * y2 * y3 + 12 * y3 ^ 2

/-- The second dual-ray ellipsoid `q_B`, in the same normalisation. -/
def ellipsoidFormB (y1 y2 y3 : ℝ) : ℝ :=
  12 * y1 ^ 2 + 20 * y1 * y2 + 6 * y1 * y3 + 20 * y2 ^ 2 + 20 * y2 * y3 + 12 * y3 ^ 2

/-- The pair form `b_01` of edges `0` and `1`. -/
def pairForm01 (y1 y2 y3 : ℝ) : ℝ :=
  (1 / 5) * y1 ^ 2 + (8 / 5) * y1 * y3 - (2 / 3) * y2 ^ 2 + 2 * y2 * y3 + (1 / 5) * y3 ^ 2

/-- The pair form `b_02` of edges `0` and `2`. -/
def pairForm02 (y1 y2 y3 : ℝ) : ℝ :=
  (1 / 5) * y1 ^ 2 + 1 * y1 * y2 + (8 / 5) * y1 * y3 + (3 / 8) * y2 ^ 2 + 1 * y2 * y3 + (1 / 5) * y3 ^ 2

/-- The pair form `b_03` of edges `0` and `3`. -/
def pairForm03 (y1 y2 y3 : ℝ) : ℝ :=
  - (3 / 10) * y1 ^ 2 - (2 / 3) * y1 * y2 - (2 / 5) * y1 * y3 - (2 / 3) * y2 ^ 2 - (2 / 3) * y2 * y3 + (1 / 5) * y3 ^ 2

/-- The pair form `b_04` of edges `0` and `4`. -/
def pairForm04 (y1 y2 y3 : ℝ) : ℝ :=
  (1 / 5) * y1 ^ 2 + (2 / 3) * y1 * y2 - (2 / 5) * y1 * y3 + (1 / 6) * y2 ^ 2 - (1 / 3) * y2 * y3 - (3 / 10) * y3 ^ 2

/-- The pair form `b_12` of edges `1` and `2`. -/
def pairForm12 (y1 y2 y3 : ℝ) : ℝ :=
  (1 / 5) * y1 ^ 2 + 2 * y1 * y2 + (8 / 5) * y1 * y3 - (2 / 3) * y2 ^ 2 + (1 / 5) * y3 ^ 2

/-- The pair form `b_13` of edges `1` and `3`. -/
def pairForm13 (y1 y2 y3 : ℝ) : ℝ :=
  - (7 / 15) * y1 ^ 2 - (4 / 3) * y1 * y2 - (26 / 15) * y1 * y3 - (2 / 3) * y2 ^ 2 - (10 / 3) * y2 * y3 - (37 / 15) * y3 ^ 2

/-- The pair form `b_14` of edges `1` and `4`. -/
def pairForm14 (y1 y2 y3 : ℝ) : ℝ :=
  - (37 / 15) * y1 ^ 2 - (10 / 3) * y1 * y2 - (26 / 15) * y1 * y3 - (2 / 3) * y2 ^ 2 - (4 / 3) * y2 * y3 - (7 / 15) * y3 ^ 2

/-- The pair form `b_23` of edges `2` and `3`. -/
def pairForm23 (y1 y2 y3 : ℝ) : ℝ :=
  - (3 / 10) * y1 ^ 2 - (1 / 3) * y1 * y2 - (2 / 5) * y1 * y3 + (1 / 6) * y2 ^ 2 + (2 / 3) * y2 * y3 + (1 / 5) * y3 ^ 2

/-- The pair form `b_24` of edges `2` and `4`. -/
def pairForm24 (y1 y2 y3 : ℝ) : ℝ :=
  (1 / 5) * y1 ^ 2 - (2 / 3) * y1 * y2 - (2 / 5) * y1 * y3 - (2 / 3) * y2 ^ 2 - (2 / 3) * y2 * y3 - (3 / 10) * y3 ^ 2

/-- The pair form `b_34` of edges `3` and `4`. -/
def pairForm34 (y1 y2 y3 : ℝ) : ℝ :=
  - (17 / 40) * y1 ^ 2 - (1 / 4) * y1 * y2 + (7 / 20) * y1 * y3 + (3 / 8) * y2 ^ 2 - (1 / 4) * y2 * y3 - (17 / 40) * y3 ^ 2

/-- The running maximum of the pair forms from `b_34` onwards. -/
def runningMaxFrom34 (y1 y2 y3 : ℝ) : ℝ :=
  pairForm34 y1 y2 y3

/-- The running maximum of the pair forms from `b_24` onwards. -/
def runningMaxFrom24 (y1 y2 y3 : ℝ) : ℝ :=
  max (pairForm24 y1 y2 y3) (runningMaxFrom34 y1 y2 y3)

/-- The running maximum of the pair forms from `b_23` onwards. -/
def runningMaxFrom23 (y1 y2 y3 : ℝ) : ℝ :=
  max (pairForm23 y1 y2 y3) (runningMaxFrom24 y1 y2 y3)

/-- The running maximum of the pair forms from `b_14` onwards. -/
def runningMaxFrom14 (y1 y2 y3 : ℝ) : ℝ :=
  max (pairForm14 y1 y2 y3) (runningMaxFrom23 y1 y2 y3)

/-- The running maximum of the pair forms from `b_13` onwards. -/
def runningMaxFrom13 (y1 y2 y3 : ℝ) : ℝ :=
  max (pairForm13 y1 y2 y3) (runningMaxFrom14 y1 y2 y3)

/-- The running maximum of the pair forms from `b_12` onwards. -/
def runningMaxFrom12 (y1 y2 y3 : ℝ) : ℝ :=
  max (pairForm12 y1 y2 y3) (runningMaxFrom13 y1 y2 y3)

/-- The running maximum of the pair forms from `b_04` onwards. -/
def runningMaxFrom04 (y1 y2 y3 : ℝ) : ℝ :=
  max (pairForm04 y1 y2 y3) (runningMaxFrom12 y1 y2 y3)

/-- The running maximum of the pair forms from `b_03` onwards. -/
def runningMaxFrom03 (y1 y2 y3 : ℝ) : ℝ :=
  max (pairForm03 y1 y2 y3) (runningMaxFrom04 y1 y2 y3)

/-- The running maximum of the pair forms from `b_02` onwards. -/
def runningMaxFrom02 (y1 y2 y3 : ℝ) : ℝ :=
  max (pairForm02 y1 y2 y3) (runningMaxFrom03 y1 y2 y3)

/-- The largest of the ten pair forms. -/
def maxPairForm (y1 y2 y3 : ℝ) : ℝ :=
  max (pairForm01 y1 y2 y3) (runningMaxFrom02 y1 y2 y3)

theorem pairForm01_le_maxPairForm (y1 y2 y3 : ℝ) :
    pairForm01 y1 y2 y3 ≤ maxPairForm y1 y2 y3 :=
  le_max_left _ _

theorem runningMaxFrom02_le_maxPairForm (y1 y2 y3 : ℝ) :
    runningMaxFrom02 y1 y2 y3 ≤ maxPairForm y1 y2 y3 :=
  le_max_right _ _

theorem pairForm02_le_maxPairForm (y1 y2 y3 : ℝ) :
    pairForm02 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_left _ _) (runningMaxFrom02_le_maxPairForm y1 y2 y3)

theorem runningMaxFrom03_le_maxPairForm (y1 y2 y3 : ℝ) :
    runningMaxFrom03 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_right _ _) (runningMaxFrom02_le_maxPairForm y1 y2 y3)

theorem pairForm03_le_maxPairForm (y1 y2 y3 : ℝ) :
    pairForm03 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_left _ _) (runningMaxFrom03_le_maxPairForm y1 y2 y3)

theorem runningMaxFrom04_le_maxPairForm (y1 y2 y3 : ℝ) :
    runningMaxFrom04 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_right _ _) (runningMaxFrom03_le_maxPairForm y1 y2 y3)

theorem pairForm04_le_maxPairForm (y1 y2 y3 : ℝ) :
    pairForm04 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_left _ _) (runningMaxFrom04_le_maxPairForm y1 y2 y3)

theorem runningMaxFrom12_le_maxPairForm (y1 y2 y3 : ℝ) :
    runningMaxFrom12 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_right _ _) (runningMaxFrom04_le_maxPairForm y1 y2 y3)

theorem pairForm12_le_maxPairForm (y1 y2 y3 : ℝ) :
    pairForm12 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_left _ _) (runningMaxFrom12_le_maxPairForm y1 y2 y3)

theorem runningMaxFrom13_le_maxPairForm (y1 y2 y3 : ℝ) :
    runningMaxFrom13 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_right _ _) (runningMaxFrom12_le_maxPairForm y1 y2 y3)

theorem pairForm13_le_maxPairForm (y1 y2 y3 : ℝ) :
    pairForm13 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_left _ _) (runningMaxFrom13_le_maxPairForm y1 y2 y3)

theorem runningMaxFrom14_le_maxPairForm (y1 y2 y3 : ℝ) :
    runningMaxFrom14 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_right _ _) (runningMaxFrom13_le_maxPairForm y1 y2 y3)

theorem pairForm14_le_maxPairForm (y1 y2 y3 : ℝ) :
    pairForm14 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_left _ _) (runningMaxFrom14_le_maxPairForm y1 y2 y3)

theorem runningMaxFrom23_le_maxPairForm (y1 y2 y3 : ℝ) :
    runningMaxFrom23 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_right _ _) (runningMaxFrom14_le_maxPairForm y1 y2 y3)

theorem pairForm23_le_maxPairForm (y1 y2 y3 : ℝ) :
    pairForm23 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_left _ _) (runningMaxFrom23_le_maxPairForm y1 y2 y3)

theorem runningMaxFrom24_le_maxPairForm (y1 y2 y3 : ℝ) :
    runningMaxFrom24 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_right _ _) (runningMaxFrom23_le_maxPairForm y1 y2 y3)

theorem pairForm24_le_maxPairForm (y1 y2 y3 : ℝ) :
    pairForm24 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_left _ _) (runningMaxFrom24_le_maxPairForm y1 y2 y3)

theorem runningMaxFrom34_le_maxPairForm (y1 y2 y3 : ℝ) :
    runningMaxFrom34 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  exact le_trans (le_max_right _ _) (runningMaxFrom24_le_maxPairForm y1 y2 y3)

theorem pairForm34_le_maxPairForm (y1 y2 y3 : ℝ) :
    pairForm34 y1 y2 y3 ≤ maxPairForm y1 y2 y3 := by
  have hrunning : runningMaxFrom34 y1 y2 y3 = pairForm34 y1 y2 y3 := rfl
  rw [← hrunning]
  exact runningMaxFrom34_le_maxPairForm y1 y2 y3

/-- The maximum of the ten pair forms is attained at one of them. -/
theorem maxPairForm_cases (y1 y2 y3 : ℝ) :
    maxPairForm y1 y2 y3 = pairForm01 y1 y2 y3 ∨
      maxPairForm y1 y2 y3 = pairForm02 y1 y2 y3 ∨
      maxPairForm y1 y2 y3 = pairForm03 y1 y2 y3 ∨
      maxPairForm y1 y2 y3 = pairForm04 y1 y2 y3 ∨
      maxPairForm y1 y2 y3 = pairForm12 y1 y2 y3 ∨
      maxPairForm y1 y2 y3 = pairForm13 y1 y2 y3 ∨
      maxPairForm y1 y2 y3 = pairForm14 y1 y2 y3 ∨
      maxPairForm y1 y2 y3 = pairForm23 y1 y2 y3 ∨
      maxPairForm y1 y2 y3 = pairForm24 y1 y2 y3 ∨
      maxPairForm y1 y2 y3 = pairForm34 y1 y2 y3 := by
  unfold maxPairForm
  rcases max_choice (pairForm01 y1 y2 y3) (runningMaxFrom02 y1 y2 y3) with hattained | hattained
  · exact Or.inl hattained
  · rw [hattained]
    unfold runningMaxFrom02
    rcases max_choice (pairForm02 y1 y2 y3) (runningMaxFrom03 y1 y2 y3) with hattained | hattained
    · exact Or.inr (Or.inl hattained)
    · rw [hattained]
      unfold runningMaxFrom03
      rcases max_choice (pairForm03 y1 y2 y3) (runningMaxFrom04 y1 y2 y3) with hattained | hattained
      · exact Or.inr (Or.inr (Or.inl hattained))
      · rw [hattained]
        unfold runningMaxFrom04
        rcases max_choice (pairForm04 y1 y2 y3) (runningMaxFrom12 y1 y2 y3) with hattained | hattained
        · exact Or.inr (Or.inr (Or.inr (Or.inl hattained)))
        · rw [hattained]
          unfold runningMaxFrom12
          rcases max_choice (pairForm12 y1 y2 y3) (runningMaxFrom13 y1 y2 y3) with hattained | hattained
          · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hattained))))
          · rw [hattained]
            unfold runningMaxFrom13
            rcases max_choice (pairForm13 y1 y2 y3) (runningMaxFrom14 y1 y2 y3) with hattained | hattained
            · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hattained)))))
            · rw [hattained]
              unfold runningMaxFrom14
              rcases max_choice (pairForm14 y1 y2 y3) (runningMaxFrom23 y1 y2 y3) with hattained | hattained
              · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hattained))))))
              · rw [hattained]
                unfold runningMaxFrom23
                rcases max_choice (pairForm23 y1 y2 y3) (runningMaxFrom24 y1 y2 y3) with hattained | hattained
                · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hattained)))))))
                · rw [hattained]
                  unfold runningMaxFrom24
                  rcases max_choice (pairForm24 y1 y2 y3) (runningMaxFrom34 y1 y2 y3) with hattained | hattained
                  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hattained))))))))
                  · rw [hattained]
                    unfold runningMaxFrom34
                    exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (rfl)))))))))

end KillFormsD7

namespace KillCellD7

/-! ## Dominance cell of the pair `(0, 1)` with
the `A` ellipsoid as target. -/
namespace Cell01A

open KillFormsD7

/-- The cell target `60 * b_01 - q_A`, scaled by `1`. -/
def targetForm (y1 y2 y3 : ℝ) : ℝ :=
  - 10 * y1 * y2 + 90 * y1 * y3 - 50 * y2 ^ 2 + 110 * y2 * y3

/-- Dominance quadric 0: `b_01 - b_02`, scaled by `24`. -/
def dominance0 (y1 y2 y3 : ℝ) : ℝ :=
  - 24 * y1 * y2 - 25 * y2 ^ 2 + 24 * y2 * y3

/-- Dominance quadric 1: `b_01 - b_03`, scaled by `6`. -/
def dominance1 (y1 y2 y3 : ℝ) : ℝ :=
  3 * y1 ^ 2 + 4 * y1 * y2 + 12 * y1 * y3 + 16 * y2 * y3

/-- Dominance quadric 2: `b_01 - b_04`, scaled by `6`. -/
def dominance2 (y1 y2 y3 : ℝ) : ℝ :=
  - 4 * y1 * y2 + 12 * y1 * y3 - 5 * y2 ^ 2 + 14 * y2 * y3 + 3 * y3 ^ 2

/-- Dominance quadric 3: `b_01 - b_12`, scaled by `1`. -/
def dominance3 (y1 y2 y3 : ℝ) : ℝ :=
  - 2 * y1 * y2 + 2 * y2 * y3

/-- Dominance quadric 4: `b_01 - b_13`, scaled by `3`. -/
def dominance4 (y1 y2 y3 : ℝ) : ℝ :=
  2 * y1 ^ 2 + 4 * y1 * y2 + 10 * y1 * y3 + 16 * y2 * y3 + 8 * y3 ^ 2

/-- Dominance quadric 5: `b_01 - b_14`, scaled by `3`. -/
def dominance5 (y1 y2 y3 : ℝ) : ℝ :=
  8 * y1 ^ 2 + 10 * y1 * y2 + 10 * y1 * y3 + 10 * y2 * y3 + 2 * y3 ^ 2

/-- Dominance quadric 6: `b_01 - b_23`, scaled by `6`. -/
def dominance6 (y1 y2 y3 : ℝ) : ℝ :=
  3 * y1 ^ 2 + 2 * y1 * y2 + 12 * y1 * y3 - 5 * y2 ^ 2 + 8 * y2 * y3

/-- Dominance quadric 7: `b_01 - b_24`, scaled by `6`. -/
def dominance7 (y1 y2 y3 : ℝ) : ℝ :=
  4 * y1 * y2 + 12 * y1 * y3 + 16 * y2 * y3 + 3 * y3 ^ 2

/-- Dominance quadric 8: `b_01 - b_34`, scaled by `24`. -/
def dominance8 (y1 y2 y3 : ℝ) : ℝ :=
  15 * y1 ^ 2 + 6 * y1 * y2 + 30 * y1 * y3 - 25 * y2 ^ 2 + 54 * y2 * y3 + 15 * y3 ^ 2

/-- The certificate weight: a positive definite quadratic form, in
its exact LDL sum-of-squares form (elimination order 1, 2, 3, so
the last term is a positive multiple of `y3 ^ 2`). -/
def weightForm (y1 y2 y3 : ℝ) : ℝ :=
  80736 * (y1 + (90 / 841) * y2 + (855 / 3364) * y3) ^ 2
  + (11030040 / 841) * (y2 + (38602 / 30639) * y3) ^ 2
  + (155952522 / 10213) * (y3) ^ 2

/-- The same weight, eliminated in the order 3, 2, 1: the last term
is a positive multiple of `y1 ^ 2`. -/
def weightFormFromThird (y1 y2 y3 : ℝ) : ℝ :=
  41304 * ((855 / 1721) * y1 + (780 / 1721) * y2 + y3) ^ 2
  + (9561240 / 1721) * (- (1052 / 8853) * y1 + y2) ^ 2
  + (207936696 / 2951) * (y1) ^ 2

/-- The same weight, eliminated in the order 1, 3, 2: the last term
is a positive multiple of `y2 ^ 2`. -/
def weightFormFromSecond (y1 y2 y3 : ℝ) : ℝ :=
  80736 * (y1 + (90 / 841) * y2 + (855 / 3364) * y3) ^ 2
  + (30350514 / 841) * ((2316120 / 5058419) * y2 + y3) ^ 2
  + (28071453960 / 5058419) * (y2) ^ 2

/-- Multiplier for dominance quadric 0, as a sum of squares. -/
def multiplier0 (y1 y2 y3 : ℝ) : ℝ :=
  102100 * (y1 + (837 / 5105) * y2 + (2907 / 4084) * y3) ^ 2
  + (184149 / 1021) * (y2 + (1070 / 20461) * y3) ^ 2
  + (19584055 / 81844) * (y3) ^ 2

/-- Multiplier for dominance quadric 1, as a sum of squares. -/
def multiplier1 (_y1 y2 y3 : ℝ) : ℝ :=
  720 * (y2) ^ 2
  + 720 * (y3) ^ 2

/-- Multiplier for dominance quadric 2, as a sum of squares. -/
def multiplier2 (y1 y2 _y3 : ℝ) : ℝ :=
  720 * (y1) ^ 2
  + 720 * (y2) ^ 2

/-- Multiplier for dominance quadric 3, as a sum of squares. -/
def multiplier3 (y1 y2 y3 : ℝ) : ℝ :=
  386640 * (y1 + (536 / 537) * y2 - (544 / 537) * y3) ^ 2
  + (1417440 / 179) * (y2 - (3229 / 5906) * y3) ^ 2
  + (20456280 / 2953) * (y3) ^ 2

/-- Multiplier for dominance quadric 4, as a sum of squares. -/
def multiplier4 (_y1 y2 _y3 : ℝ) : ℝ :=
  1440 * (y2) ^ 2

/-- Multiplier for dominance quadric 5, as a sum of squares. -/
def multiplier5 (_y1 y2 _y3 : ℝ) : ℝ :=
  1440 * (y2) ^ 2

/-- Multiplier for dominance quadric 6, as a sum of squares. -/
def multiplier6 (_y1 y2 y3 : ℝ) : ℝ :=
  287280 * (y2 + (1651 / 1596) * y3) ^ 2
  + (217965 / 133) * (y3) ^ 2

/-- Multiplier for dominance quadric 7, as a sum of squares. -/
def multiplier7 (y1 y2 _y3 : ℝ) : ℝ :=
  604800 * (y1 - (53 / 280) * y2) ^ 2
  + (4554 / 7) * (y2) ^ 2

/-- Multiplier for dominance quadric 8, as a sum of squares. -/
def multiplier8 (_y1 y2 _y3 : ℝ) : ℝ :=
  180 * (y2) ^ 2

/-- The sum-of-squares remainder: a quartic, in its exact LDL form
over the six quadratic monomials. -/
def sosRemainder (y1 y2 y3 : ℝ) : ℝ :=
  815625 * (y2 ^ 2 + (44 / 18125) * y1 * y2 - (2237 / 18125) * y1 * y3 - (3779 / 18125) * y2 * y3) ^ 2
  + (2640577576 / 3625) * (y1 * y2 + (58542 / 47153171) * y1 * y3 - (4793697 / 94306342) * y2 * y3) ^ 2
  + (44101169439345 / 47153171) * (y1 * y3 + (786507551825 / 2940077962623) * y2 * y3) ^ 2
  + (941903944691806380 / 980025987541) * (y2 * y3) ^ 2

theorem weightFormFromThird_eq (y1 y2 y3 : ℝ) :
    weightFormFromThird y1 y2 y3 = weightForm y1 y2 y3 := by
  unfold weightFormFromThird weightForm; ring

theorem weightFormFromSecond_eq (y1 y2 y3 : ℝ) :
    weightFormFromSecond y1 y2 y3 = weightForm y1 y2 y3 := by
  unfold weightFormFromSecond weightForm; ring

/-- **The certificate identity.**  A polynomial identity over `ℝ`;
`ring` closes it, and it is the entire mathematical content of this
cell's proof. -/
theorem certificate_identity (y1 y2 y3 : ℝ) :
    weightForm y1 y2 y3 * targetForm y1 y2 y3
      = multiplier0 y1 y2 y3 * dominance0 y1 y2 y3 +
        multiplier1 y1 y2 y3 * dominance1 y1 y2 y3 +
        multiplier2 y1 y2 y3 * dominance2 y1 y2 y3 +
        multiplier3 y1 y2 y3 * dominance3 y1 y2 y3 +
        multiplier4 y1 y2 y3 * dominance4 y1 y2 y3 +
        multiplier5 y1 y2 y3 * dominance5 y1 y2 y3 +
        multiplier6 y1 y2 y3 * dominance6 y1 y2 y3 +
        multiplier7 y1 y2 y3 * dominance7 y1 y2 y3 +
        multiplier8 y1 y2 y3 * dominance8 y1 y2 y3 +
        sosRemainder y1 y2 y3 := by
  unfold weightForm targetForm sosRemainder
  unfold multiplier0 multiplier1 multiplier2 multiplier3 multiplier4 multiplier5 multiplier6 multiplier7 multiplier8
  unfold dominance0 dominance1 dominance2 dominance3 dominance4 dominance5 dominance6 dominance7 dominance8
  ring

theorem multiplier0_nonneg (y1 y2 y3 : ℝ) :
    0 ≤ multiplier0 y1 y2 y3 := by
