/-- Dominance quadric 3: `b_02 - b_12`, scaled by `24`. -/
def dominance3 (y1 y2 y3 : ℝ) : ℝ :=
  - 24 * y1 * y2 + 25 * y2 ^ 2 + 24 * y2 * y3

