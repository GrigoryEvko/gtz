theorem ellipsoidFormB_le_of_dominant (y1 y2 y3 : ℝ)
    (hne : y1 ≠ 0 ∨ y2 ≠ 0 ∨ y3 ≠ 0)
    (hdominant : maxPairForm y1 y2 y3 = pairForm01 y1 y2 y3) :
    ellipsoidFormB y1 y2 y3 ≤ 60 * maxPairForm y1 y2 y3 := by
  have hbound02 : pairForm02 y1 y2 y3 ≤ pairForm01 y1 y2 y3 := by
    rw [← hdominant]
