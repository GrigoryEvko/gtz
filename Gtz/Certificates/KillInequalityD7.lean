def weightForm (y1 y2 y3 : ℝ) : ℝ :=
  8256 * (y1 + (279 / 172) * y2 + (135 / 172) * y3) ^ 2
  + (277992 / 43) * (y2 + (1147 / 2574) * y3) ^ 2
  + (269730 / 143) * (y3) ^ 2

