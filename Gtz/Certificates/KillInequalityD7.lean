/-- The sum-of-squares remainder: a sextic, in its exact LDL form
over the ten cubic monomials. -/
def sosRemainder (y1 y2 y3 : ℝ) : ℝ :=
   * (y1 ^ 3 - ( / ) * y1 ^ 2 * y2 - ( / ) * y1 ^ 2 * y3 - ( / ) * y1 * y2 ^ 2 - ( / ) * y1 * y2 * y3 - ( / ) * y1 * y3 ^ 2 - ( / ) * y2 ^ 3 + ( / ) * y2 ^ 2 * y3 + ( / ) * y2 * y3 ^ 2 + ( / ) * y3 ^ 3) ^ 2
  + ( / ) * (y1 ^ 2 * y2 + ( / ) * y1 ^ 2 * y3 + ( / ) * y1 * y2 ^ 2 + ( / ) * y1 * y2 * y3 - ( / ) * y1 * y3 ^ 2 - ( / ) * y2 ^ 3 + ( / ) * y2 ^ 2 * y3 + ( / ) * y2 * y3 ^ 2 + ( / ) * y3 ^ 3) ^ 2
  + ( / ) * (y1 ^ 2 * y3 - ( / ) * y1 * y2 ^ 2 + ( / ) * y1 * y2 * y3 + ( / ) * y1 * y3 ^ 2 - ( / ) * y2 ^ 3 - ( / ) * y2 ^ 2 * y3 - ( / ) * y2 * y3 ^ 2 - ( / ) * y3 ^ 3) ^ 2
  + ( / ) * (y1 * y2 ^ 2 - ( / ) * y1 * y2 * y3 - ( / ) * y1 * y3 ^ 2 - ( / ) * y2 ^ 3 + ( / ) * y2 ^ 2 * y3 + ( / ) * y2 * y3 ^ 2 - ( / ) * y3 ^ 3) ^ 2
  + ( / ) * (y1 * y2 * y3 + ( / ) * y1 * y3 ^ 2 + ( / ) * y2 ^ 3 + ( / ) * y2 ^ 2 * y3 - ( / ) * y2 * y3 ^ 2 + ( / ) * y3 ^ 3) ^ 2
  + ( / ) * (y1 * y3 ^ 2 - ( / ) * y2 ^ 3 - ( / ) * y2 ^ 2 * y3 - ( / ) * y2 * y3 ^ 2 - ( / ) * y3 ^ 3) ^ 2
  + ( / ) * (y2 ^ 3 + ( / ) * y2 ^ 2 * y3 - ( / ) * y2 * y3 ^ 2 - ( / ) * y3 ^ 3) ^ 2
  + ( / ) * (y2 ^ 2 * y3 + (13 / 7) * y2 * y3 ^ 2 + (6 / 7) * y3 ^ 3) ^ 2

