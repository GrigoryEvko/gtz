/-! ## Dominance cell of the pair `(2, 3)` with
the `A` ellipsoid as target. -/
namespace Cell23A

open KillFormsD7

/-- The cell target `60 * b_23 - q_A`, scaled by `1`. -/
def targetForm (y1 y2 y3 : ℝ) : ℝ :=
  - 30 * y1 ^ 2 - 30 * y1 * y2 - 30 * y1 * y3 + 30 * y2 * y3

/-- Dominance quadric 0: `b_23 - b_01`, scaled by `6`. -/
def dominance0 (y1 y2 y3 : ℝ) : ℝ :=
  - 3 * y1 ^ 2 - 2 * y1 * y2 - 12 * y1 * y3 + 5 * y2 ^ 2 - 8 * y2 * y3

/-- Dominance quadric 1: `b_23 - b_02`, scaled by `24`. -/
def dominance1 (y1 y2 y3 : ℝ) : ℝ :=
  - 12 * y1 ^ 2 - 32 * y1 * y2 - 48 * y1 * y3 - 5 * y2 ^ 2 - 8 * y2 * y3

/-- Dominance quadric 2: `b_23 - b_03`, scaled by `6`. -/
def dominance2 (y1 y2 y3 : ℝ) : ℝ :=
  2 * y1 * y2 + 5 * y2 ^ 2 + 8 * y2 * y3

/-- Dominance quadric 3: `b_23 - b_04`, scaled by `2`. -/
def dominance3 (y1 y2 y3 : ℝ) : ℝ :=
  - 1 * y1 ^ 2 - 2 * y1 * y2 + 2 * y2 * y3 + 1 * y3 ^ 2

/-- Dominance quadric 4: `b_23 - b_12`, scaled by `6`. -/
def dominance4 (y1 y2 y3 : ℝ) : ℝ :=
  - 3 * y1 ^ 2 - 14 * y1 * y2 - 12 * y1 * y3 + 5 * y2 ^ 2 + 4 * y2 * y3

/-- Dominance quadric 5: `b_23 - b_13`, scaled by `6`. -/
def dominance5 (y1 y2 y3 : ℝ) : ℝ :=
  1 * y1 ^ 2 + 6 * y1 * y2 + 8 * y1 * y3 + 5 * y2 ^ 2 + 24 * y2 * y3 + 16 * y3 ^ 2

/-- Dominance quadric 6: `b_23 - b_14`, scaled by `6`. -/
def dominance6 (y1 y2 y3 : ℝ) : ℝ :=
  13 * y1 ^ 2 + 18 * y1 * y2 + 8 * y1 * y3 + 5 * y2 ^ 2 + 12 * y2 * y3 + 4 * y3 ^ 2

