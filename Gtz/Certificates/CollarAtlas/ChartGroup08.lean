      (.node 2
        (.leaf (.windowWin 2 0))
        (.leaf (.windowWin 3 0))      )    )  )

def chartData : ChartData :=
  ⟨chartCores, chartVariants, chartThresholds, chartCandidates,
   chartCover⟩

/-- The replayed check: one kernel evaluation of the whole certificate. -/
theorem chartCheckPasses : checkChart chartData = true := by decide

/-- KERNEL-CHECKED: the collar window sign package holds at every
rational point of this chart's half-open cube. -/
theorem chartWindowCertified (den one two three four : Int)
    (domain : PointLiesInDomain den one two three four) :
    WindowWitnessAt chartData den one two three four :=
  checkChart_sound chartData chartCheckPasses den one two three four
    domain

