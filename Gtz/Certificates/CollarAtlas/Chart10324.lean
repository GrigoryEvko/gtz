  (.node 0
    (.leaf (.guardPair 5 0 2 0 4))
    (.node 1
      (.node 2
        (.node 3
          (.leaf (.windowWin 3 0))
          (.node 0
            (.leaf (.windowWin 3 0))
            (.leaf (.guardPair 1 0 0 0 2))          )        )
        (.node 3
          (.leaf (.windowWin 3 0))
          (.node 0
