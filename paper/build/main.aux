\@writefile{lof}{\contentsline {figure}{\numberline {31}{\ignorespaces The two simplices at $(4,3)$. Left: the weights, in $\Delta ^{3}$. Right: the leverage scores, confined by Lemmas\nonbreakingspace \ref {lem:trace} and\nonbreakingspace \ref {lem:share} to $\{s\in [0,1]^{4}:\DOTSB \sum@ \slimits@ _c s_c=3\}$, which at corank one is again $\Delta ^{3}$, in the coordinates $1-s_c$. The tetrahedron design of Example\nonbreakingspace \ref {ex:tetra} is the barycentre of each. With its chart held fixed (Lemma\nonbreakingspace \ref {lem:realize}) the weights run to a vertex while the leverage scores stand still, and the leverages $\ell _c=s_c/t_c$ diverge; Example\nonbreakingspace \ref {ex:escape} is the same motion at $(2,1)$. The leverage score is the coordinate that stays compact and the weight the one that reaches the boundary, so the compactification is taken in $(P,t)$ rather than in the design data.}}{61}{figure.31}\protected@file@percent }
\newlabel{fig:twosimplices}{{31}{61}{The two simplices at $(4,3)$. Left: the weights, in $\Delta ^{3}$. Right: the leverage scores, confined by Lemmas~\ref {lem:trace} and~\ref {lem:share} to $\{s\in [0,1]^{4}:\sum _c s_c=3\}$, which at corank one is again $\Delta ^{3}$, in the coordinates $1-s_c$. The tetrahedron design of Example~\ref {ex:tetra} is the barycentre of each. With its chart held fixed (Lemma~\ref {lem:realize}) the weights run to a vertex while the leverage scores stand still, and the leverages $\ell _c=s_c/t_c$ diverge; Example~\ref {ex:escape} is the same motion at $(2,1)$. The leverage score is the coordinate that stays compact and the weight the one that reaches the boundary, so the compactification is taken in $(P,t)$ rather than in the design data}{figure.31}{}}
