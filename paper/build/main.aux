\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The compactification and the boundary dichotomy. Left: the objective $G$ of \eqref  {eq:objective} is continuous on a compact space, so it attains its minimum; Theorem\nonbreakingspace \ref {thm:boundary} empties the faces $t_z=0$ of counterexamples, which places the minimum in the interior. Right: the two mechanisms, separated by the pivot identity \eqref  {eq:pivot}. At $P_{zz}=0$ the atom is deleted and the weights rescaled; at $P_{zz}>0$ the point is deflated by \eqref  {eq:deflate} and the selected subset regains $z$, the deficit in \eqref  {eq:schur} being absent exactly because $t_z=0$.}}{47}{figure.7}\protected@file@percent }
\newlabel{fig:boundary}{{7}{47}{The compactification and the boundary dichotomy. Left: the objective $G$ of \eqref {eq:objective} is continuous on a compact space, so it attains its minimum; Theorem~\ref {thm:boundary} empties the faces $t_z=0$ of counterexamples, which places the minimum in the interior. Right: the two mechanisms, separated by the pivot identity \eqref {eq:pivot}. At $P_{zz}=0$ the atom is deleted and the weights rescaled; at $P_{zz}>0$ the point is deflated by \eqref {eq:deflate} and the selected subset regains $z$, the deficit in \eqref {eq:schur} being absent exactly because $t_z=0$}{figure.7}{}}
