\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The twenty triples of Example\nonbreakingspace \ref {ex:octa} on one eigenvalue axis. Eight take one atom from each antipodal pair and have $S_{C}=3I_3$; twelve repeat an axis and have $\operatorname  {spec}S_{C}=\{0,3,6\}$. The trace is $9$ in both rows, so the trace test \eqref  {eq:tracetest} passes at all twenty. The second scale is the chart gap of \S  \ref {sec:chart}, which at uniform weight $\tfrac  16$ is $\operatorname  {spec}W[C] =\tfrac  16(\operatorname  {spec}S_{C}-1)$; Corollary\nonbreakingspace \ref {cor:minor} returns the two determinants a second way, and volume sampling puts all its mass on the eight.}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:octaspec}{{5}{12}{The twenty triples of Example~\ref {ex:octa} on one eigenvalue axis. Eight take one atom from each antipodal pair and have $\SC =3I_3$; twelve repeat an axis and have $\operatorname {spec}\SC =\{0,3,6\}$. The trace is $9$ in both rows, so the trace test \eqref {eq:tracetest} passes at all twenty. The second scale is the chart gap of \S \ref {sec:chart}, which at uniform weight $\tfrac 16$ is $\operatorname {spec}W[C] =\tfrac 16(\operatorname {spec}\SC -1)$; Corollary~\ref {cor:minor} returns the two determinants a second way, and volume sampling puts all its mass on the eight}{figure.5}{}}
\newlabel{eq:tetraspec}{{10}{12}{Lean}{equation.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The design of Example\nonbreakingspace \ref {ex:tetra}: four vectors to the vertices of a regular tetrahedron, drawn inside the cube whose even-sign vertices they are. Every triple omits one vector and has spectrum $\{1,4,4\}$ by \eqref  {eq:tetraspec}, so it dominates with nothing to spare.}}{13}{figure.6}\protected@file@percent }
\newlabel{fig:tetrahedron}{{6}{13}{The design of Example~\ref {ex:tetra}: four vectors to the vertices of a regular tetrahedron, drawn inside the cube whose even-sign vertices they are. Every triple omits one vector and has spectrum $\{1,4,4\}$ by \eqref {eq:tetraspec}, so it dominates with nothing to spare}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The gap $S_{C}-I_3$ at the triple $C=\{0,1,2\}$ of Example\nonbreakingspace \ref {ex:tetra}. Left: the level set $x^{\mathsf  {T}}(S_{C}-I_3)x=1$, in the cube and the projection of Figure\nonbreakingspace \ref {fig:tetrahedron}; the omitted atom $g_3$ carries an open head and spans the null line. Right: the same set seen along that line. Both nonzero eigenvalues of the gap equal $3$ (\S  \ref {app:tetra}), so the level set is a circular cylinder of radius $1/\sqrt  3$ rather than a general elliptic one. Dominating with nothing to spare is a form singular along one line, and that line is spanned by the atom the triple omits (\S  \ref {sec:ties}).}}{13}{figure.7}\protected@file@percent }
\newlabel{fig:tetragap}{{7}{13}{The gap $\SC -I_3$ at the triple $C=\{0,1,2\}$ of Example~\ref {ex:tetra}. Left: the level set $x\tp (\SC -I_3)x=1$, in the cube and the projection of Figure~\ref {fig:tetrahedron}; the omitted atom $g_3$ carries an open head and spans the null line. Right: the same set seen along that line. Both nonzero eigenvalues of the gap equal $3$ (\S \ref {app:tetra}), so the level set is a circular cylinder of radius $1/\sqrt 3$ rather than a general elliptic one. Dominating with nothing to spare is a form singular along one line, and that line is spanned by the atom the triple omits (\S \ref {sec:ties})}{figure.7}{}}
