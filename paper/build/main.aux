\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The decision board. Rows are the rank $k$, columns the size $m$; cells with $m<k$ carry no design. Over $\mathbb  {R}$ the two open cells at rank three are $(6,3)$ and $(7,3)$; the hatched region reduces to them by Theorem\nonbreakingspace \ref {thm:window} and Corollary\nonbreakingspace \ref {cor:dualcell}. Over $\mathbb  {C}$ the answer is $m\le k+1$ for every $k\ge 2$.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:board}{{2}{7}{The decision board. Rows are the rank $k$, columns the size $m$; cells with $m<k$ carry no design. Over $\R $ the two open cells at rank three are $(6,3)$ and $(7,3)$; the hatched region reduces to them by Theorem~\ref {thm:window} and Corollary~\ref {cor:dualcell}. Over $\C $ the answer is $m\le k+1$ for every $k\ge 2$}{figure.2}{}}
