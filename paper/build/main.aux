\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The witness of Lemma\nonbreakingspace \ref {lem:direction} on the design of Example\nonbreakingspace \ref {ex:octa}. Left: the sphere of directions, the upper cap of the region $3x_3^2\ge \lVert x\rVert ^2$ witnessed by the third axis, and the meridian from $e_3$ to $(e_1+e_2)/\sqrt  2$ across it; the rim carries four of the eight directions at which the bound is an equality at all six atoms, three of them in front. Right: the meridian read twice. One atom at a time, the maximum stays at or above $\lVert x\rVert ^2$ and the index attaining it changes at $\theta _*$, where the two curves meet each other and the level $\lVert x\rVert ^2$ together. Three atoms at once, the sum over $\{0,1,2\}$ falls below $\lVert x\rVert ^2$ on $[0,\theta _1)$, an arc about the axis that triple omits, while $\operatorname  {tr}S_{C}=9$ there as at every triple.}}{11}{figure.4}\protected@file@percent }
\newlabel{fig:witness}{{4}{11}{The witness of Lemma~\ref {lem:direction} on the design of Example~\ref {ex:octa}. Left: the sphere of directions, the upper cap of the region $3x_3^2\ge \lVert x\rVert ^2$ witnessed by the third axis, and the meridian from $e_3$ to $(e_1+e_2)/\sqrt 2$ across it; the rim carries four of the eight directions at which the bound is an equality at all six atoms, three of them in front. Right: the meridian read twice. One atom at a time, the maximum stays at or above $\lVert x\rVert ^2$ and the index attaining it changes at $\theta _*$, where the two curves meet each other and the level $\lVert x\rVert ^2$ together. Three atoms at once, the sum over $\{0,1,2\}$ falls below $\lVert x\rVert ^2$ on $[0,\theta _1)$, an arc about the axis that triple omits, while $\tr \SC =9$ there as at every triple}{figure.4}{}}
