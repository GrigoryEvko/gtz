\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The identity \eqref  {eq:deficit} at $(7,3)$, and the deficit over the board of Figure\nonbreakingspace \ref {fig:board}. Left: the $k\times (m-k)$ rectangle with one cell adjoined, cut by its bottom row and its right column; the hook so cut has $(m-k)+k-1=m-1$ cells, and with the adjoined cell it numbers $m$, leaving the block of $(k-1)(m-k-1)$. Below it, the maximal-volume bound against the conjecture at the two cells that survive at rank three; the ratio of the two denominators is $k-(k^2-1)/m$, which at rank three is $3-8/m$ and grows with the size towards $k$. Right: the integer $(k-1)(m-k-1)$ at every cell of corank at least one; over $\mathbb  {C}$ its zeros are the cells at which selection succeeds and its positive entries those at which it fails (Theorem\nonbreakingspace \ref {thm:complex}). No design is exhibited at either surviving cell, and nothing here asserts that the classical bound is attained at one.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:deficit}{{1}{4}{The identity \eqref {eq:deficit} at $(7,3)$, and the deficit over the board of Figure~\ref {fig:board}. Left: the $k\times (m-k)$ rectangle with one cell adjoined, cut by its bottom row and its right column; the hook so cut has $(m-k)+k-1=m-1$ cells, and with the adjoined cell it numbers $m$, leaving the block of $(k-1)(m-k-1)$. Below it, the maximal-volume bound against the conjecture at the two cells that survive at rank three; the ratio of the two denominators is $k-(k^2-1)/m$, which at rank three is $3-8/m$ and grows with the size towards $k$. Right: the integer $(k-1)(m-k-1)$ at every cell of corank at least one; over $\C $ its zeros are the cells at which selection succeeds and its positive entries those at which it fails (Theorem~\ref {thm:complex}). No design is exhibited at either surviving cell, and nothing here asserts that the classical bound is attained at one}{figure.1}{}}
