\@writefile{lof}{\contentsline {figure}{\numberline {30}{\ignorespaces Volume sampling at the tetrahedron of Example\nonbreakingspace \ref {ex:tetra}. Left: the measure \eqref  {eq:dpp} on the four triples as a bar of mass one, and below it one row per atom hatching the triples that contain it, so that the hatched mass is the marginal of Lemma\nonbreakingspace \ref {lem:marginal}. Right: the common spectrum of the four triples, the spectrum of the average, and the mixture \eqref  {eq:mixture} over its own baseline, whose root at the threshold Proposition\nonbreakingspace \ref {prop:qone} forces at a totally tight design. The two rows put Theorem\nonbreakingspace \ref {thm:average} and Corollary\nonbreakingspace \ref {cor:nomargin} at one design. The common spectrum and the mixture are mechanized. The four masses, the marginals hatched below them and the average's own spectrum are not: the development carries the masses only through their sum, and Lemma\nonbreakingspace \ref {lem:marginal}, which names the average, is a hypothesis there rather than a theorem.}}{60}{figure.30}\protected@file@percent }
\newlabel{fig:mixture}{{30}{60}{Volume sampling at the tetrahedron of Example~\ref {ex:tetra}. Left: the measure \eqref {eq:dpp} on the four triples as a bar of mass one, and below it one row per atom hatching the triples that contain it, so that the hatched mass is the marginal of Lemma~\ref {lem:marginal}. Right: the common spectrum of the four triples, the spectrum of the average, and the mixture \eqref {eq:mixture} over its own baseline, whose root at the threshold Proposition~\ref {prop:qone} forces at a totally tight design. The two rows put Theorem~\ref {thm:average} and Corollary~\ref {cor:nomargin} at one design. The common spectrum and the mixture are mechanized. The four masses, the marginals hatched below them and the average's own spectrum are not: the development carries the masses only through their sum, and Lemma~\ref {lem:marginal}, which names the average, is a hypothesis there rather than a theorem}{figure.30}{}}
