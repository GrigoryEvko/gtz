\@writefile{lof}{\contentsline {figure}{\numberline {43}{\ignorespaces The bundled cycle. Left: arc $j$ of the $4$-cycle carries $p_j$ parallel edges of conductance $1/\bigl  (p_j(n-p_j)\bigr  )$, drawn at $p=(2,2,1,1)$ and $n=6$; the three heavy edges are a transversal and the open vertex is the ground. Middle: the closed form, and seven bundlings, each an exact tie; every distinct rank-three leverage listed is evaluated in the kernel, and at rank two what the kernel evaluates is the companion projection diagonal, $8/63$ and $5/9$ at $(7,1,1)$, and $13/72$, $2/9$ and $11/36$ at $(4,3,2)$. Right: at rank two the gap is the rational square above, drawn at $(p_1,p_2)=(4,3)$, where the heavy line is the ray $d\propto p$ and the two dashed lines are the level $3/7$. Every leverage listed satisfies $k\,T\,\ell _e=k-1+T$ at the arc total $T=p/n$, which is \eqref  {eq:tielaw}.}}{108}{figure.43}\protected@file@percent }
\newlabel{fig:bundledcycle}{{43}{108}{The bundled cycle. Left: arc $j$ of the $4$-cycle carries $p_j$ parallel edges of conductance $1/\bigl (p_j(n-p_j)\bigr )$, drawn at $p=(2,2,1,1)$ and $n=6$; the three heavy edges are a transversal and the open vertex is the ground. Middle: the closed form, and seven bundlings, each an exact tie; every distinct rank-three leverage listed is evaluated in the kernel, and at rank two what the kernel evaluates is the companion projection diagonal, $8/63$ and $5/9$ at $(7,1,1)$, and $13/72$, $2/9$ and $11/36$ at $(4,3,2)$. Right: at rank two the gap is the rational square above, drawn at $(p_1,p_2)=(4,3)$, where the heavy line is the ray $d\propto p$ and the two dashed lines are the level $3/7$. Every leverage listed satisfies $k\,T\,\ell _e=k-1+T$ at the arc total $T=p/n$, which is \eqref {eq:tielaw}}{figure.43}{}}
