\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces The certificate of Example\nonbreakingspace \ref {ex:tetra} at the triple $C=\{1,2,3\}$. Each square $(x_i-x_j)^2$ vanishes on a plane spanned by $g_0$ and one selected atom, drawn left as its great circle on the circumsphere; the three planes meet in $\mathbb  {R}g_0$ alone, the eigenline of $S_{C}$ for the eigenvalue $1$ of \eqref  {eq:tetraspec}. Right: the same three planes seen along that line, six rays $60^{\circ }$ apart, with the unit normals $n_c$, signed to sum to zero, at $120^{\circ }$ and the level $x^{\mathsf  {T}}(S_{C}-I_3)x=1$ the circle of radius $1/\sqrt  3$ of Figure\nonbreakingspace \ref {fig:tetragap}. The grouping drawn is the one of Example\nonbreakingspace \ref {ex:tetra}; the development certifies the triple $C=\{0,1,2\}$ instead, by the image of this certificate under $\operatorname  {diag}(-1,-1,1)$, which permutes the atoms by $(0\,3)(1\,2)$.}}{14}{figure.8}\protected@file@percent }
\newlabel{fig:tetracert}{{8}{14}{The certificate of Example~\ref {ex:tetra} at the triple $C=\{1,2,3\}$. Each square $(x_i-x_j)^2$ vanishes on a plane spanned by $g_0$ and one selected atom, drawn left as its great circle on the circumsphere; the three planes meet in $\R g_0$ alone, the eigenline of $\SC $ for the eigenvalue $1$ of \eqref {eq:tetraspec}. Right: the same three planes seen along that line, six rays $60^{\circ }$ apart, with the unit normals $n_c$, signed to sum to zero, at $120^{\circ }$ and the level $x\tp (\SC -I_3)x=1$ the circle of radius $1/\sqrt 3$ of Figure~\ref {fig:tetragap}. The grouping drawn is the one of Example~\ref {ex:tetra}; the development certifies the triple $C=\{0,1,2\}$ instead, by the image of this certificate under $\diag (-1,-1,1)$, which permutes the atoms by $(0\,3)(1\,2)$}{figure.8}{}}
