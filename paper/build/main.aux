\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces The cone $\{A\succeq 0\}$ in $\mathrm  {Sym}_2$. The three coordinate directions are Frobenius-orthogonal of equal length, so the cone is circular, of half-angle $\pi /4$ about the ray of scalar matrices. Left: the rank-two trine of Example\nonbreakingspace \ref {ex:trine2}. Its three atoms lie on the boundary circle at height $1$, and \eqref  {eq:parseval} exhibits $I_2$ as their centroid. Right: the horizontal projection. The atom of $g_c$ lands at radius $\ell _c/2$ and at argument $2\theta _c$, twice that of $g_c$: the dot at the midpoint of $\eta _c$. So $g_c$ and $-g_c$ give the same point, and the doubling is \eqref  {eq:doubleangle}. The window $N(2)$ of Theorem\nonbreakingspace \ref {thm:window} is the Carath\'eodory number of this space.}}{47}{figure.23}\protected@file@percent }
\newlabel{fig:psdcone}{{23}{47}{The cone $\{A\psd 0\}$ in $\mathrm {Sym}_2$. The three coordinate directions are Frobenius-orthogonal of equal length, so the cone is circular, of half-angle $\pi /4$ about the ray of scalar matrices. Left: the rank-two trine of Example~\ref {ex:trine2}. Its three atoms lie on the boundary circle at height $1$, and \eqref {eq:parseval} exhibits $I_2$ as their centroid. Right: the horizontal projection. The atom of $g_c$ lands at radius $\ell _c/2$ and at argument $2\theta _c$, twice that of $g_c$: the dot at the midpoint of $\eta _c$. So $g_c$ and $-g_c$ give the same point, and the doubling is \eqref {eq:doubleangle}. The window $\win (2)$ of Theorem~\ref {thm:window} is the Carath\'eodory number of this space}{figure.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces Theorem\nonbreakingspace \ref {thm:reduce} at $(5,2)$, in the coordinates of Figure\nonbreakingspace \ref {fig:psdcone}. Left: five rank-one atoms on the boundary of the cone, at heights $\ell _c/2$, with $I_2$ their $t$-barycentre by \eqref  {eq:parseval}; disc area is the weight, and the signed integer beside an atom is its coordinate of $\delta $. Since $\dim \mathrm  {Sym}_2+1=N(2)=4<5$ the moment map has a kernel, here the line spanned by $\delta =(-9,1,3,-3,8)$. Right: the five weights $t_c-\theta \delta _c$ along that line, every one of them a Parseval weighting, all nonnegative exactly on $-\tfrac  1{42}\le \theta \le \tfrac  1{56}$. At the right end the ringed atom loses its weight and the design drops to $(4,2)$ with $t'=\tfrac  18(3,1,3,1,0)$; the atoms themselves never moved, which leaves the smaller design on a subfamily of the given vectors.}}{47}{figure.24}\protected@file@percent }
\newlabel{fig:crystal}{{24}{47}{Theorem~\ref {thm:reduce} at $(5,2)$, in the coordinates of Figure~\ref {fig:psdcone}. Left: five rank-one atoms on the boundary of the cone, at heights $\ell _c/2$, with $I_2$ their $t$-barycentre by \eqref {eq:parseval}; disc area is the weight, and the signed integer beside an atom is its coordinate of $\delta $. Since $\dim \mathrm {Sym}_2+1=\win (2)=4<5$ the moment map has a kernel, here the line spanned by $\delta =(-9,1,3,-3,8)$. Right: the five weights $t_c-\theta \delta _c$ along that line, every one of them a Parseval weighting, all nonnegative exactly on $-\tfrac 1{42}\le \theta \le \tfrac 1{56}$. At the right end the ringed atom loses its weight and the design drops to $(4,2)$ with $t'=\tfrac 18(3,1,3,1,0)$; the atoms themselves never moved, which leaves the smaller design on a subfamily of the given vectors}{figure.24}{}}
